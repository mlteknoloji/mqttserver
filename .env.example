HOST=0.0.0.0
MQTT_PORT=1883
WEB_PORT=3000
MQTT_HOST=192.168.1.100

# Web paneli HTTPS (isteğe bağlı; etkinse WEB_HTTPS_PORT dinlenir)
WEB_HTTPS_ENABLED=0
WEB_HTTPS_PORT=3443
WEB_HTTPS_KEY=certs/server-key.pem
WEB_HTTPS_CERT=certs/server-cert.pem
# WEB_HTTPS_CA=certs/ca-cert.pem

MQTT_USERNAME=admin
MQTT_PASSWORD=buraya-guclu-bir-parola-yazin

# MQTT TLS (8883)
MQTT_TLS_ENABLED=0
MQTT_TLS_PORT=8883
MQTT_TLS_KEY=certs/server-key.pem
MQTT_TLS_CERT=certs/server-cert.pem
MQTT_TLS_CA=certs/ca-cert.pem
MQTT_TLS_REQUEST_CLIENT_CERT=0
MQTT_TLS_CLIENT_CERT=certs/client-cert.pem
MQTT_TLS_CLIENT_KEY=certs/client-key.pem

# Fail2Ban benzeri MQTT giriş koruması
FAIL2BAN_MAX_ATTEMPTS=5
FAIL2BAN_FIND_TIME_MINUTES=10
FAIL2BAN_BAN_TIME_MINUTES=60
SECURITY_DB_PATH=security.sqlite3
HISTORY_RETENTION_DAYS=90
DEVICE_STALE_AFTER_SECONDS=300

# MQTT topic yetkilendirmesi (0 = kullanıcılar tüm topic'lere erişebilir)
MQTT_TOPIC_ENFORCEMENT=1

# Web paneli giriş koruması
WEB_LOGIN_MAX_ATTEMPTS=5
WEB_LOGIN_FIND_TIME_MINUTES=10
WEB_LOGIN_LOCK_MINUTES=15

# Yalnızca ilk veritabanı oluşturulurken kullanılır (en az 12 karakter).
INITIAL_ADMIN_USERNAME=admin@example.com
INITIAL_ADMIN_PASSWORD=buraya-en-az-12-karakterli-guclu-parola-yazin
# Cihazların firmware indirebildiği dış/LAN adresi (isteğe bağlı)
# FIRMWARE_PUBLIC_BASE_URL=http://192.168.1.4:3000
