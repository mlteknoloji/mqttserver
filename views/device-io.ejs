<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cihaz I/O İzleme · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/standalone-sidebar',{activePage:'device-io'}) %><main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY MQTT</p><h1>Cihaz Input / Output İzleme</h1></div><div class="standalone-nav"><span id="socket-status" class="status offline">Bağlanıyor...</span><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>Canlı cihaz verileri</h2><span>Output kontrolü / input / voltaj / JSON</span></div><div class="device-selector"><label>İzlenecek kullanıcı / cihaz<select id="device"><option value="">Çevrimiçi cihaz seçin</option></select></label><div class="device-selector-actions"><span id="last-seen">Cihaz seçilmedi</span><button id="sync" class="secondary-button" type="button" disabled>Durumu Yenile</button><button id="restart" class="danger-button" type="button" disabled>Yeniden Başlat</button></div></div><div id="meta" class="io-device-meta">Date Time: —, Voltage: —, Uptime: —, Temperature: —</div><div class="io-visual"><div><h3>Output / röleler</h3><div id="relays" class="io-output-grid"></div></div><div><h3>Inputlar</h3><div id="inputs" class="io-input-grid"></div></div></div><div class="raw-json"><div><h3>Son gelen cihaz JSON verisi</h3><button id="copy" class="secondary-button">JSON kopyala</button></div><pre id="json" data-i18n-translate>Cihazdan henüz JSON verisi alınmadı.</pre></div><div class="send-row io-result-row"><span id="result"></span></div></section></main>
<script>
let socket,clients=[],user=null;const $=id=>document.getElementById(id);function uptime(ms){let s=Math.floor((ms||0)/1000),d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);return `${d} gün, ${h} saat, ${m} dakika, ${s%60} saniye`}
function draw(){const d=clients.find(x=>x.clientId===$('device').value),can=user?.role==='admin'||user?.permissions?.includes('relay');$('relays').replaceChildren();$('inputs').replaceChildren();$('restart').disabled=!d||!can;$('last-seen').textContent=d?`Son görülme: ${d.lastSeenAt||d.connectedAt}`:'Cihaz seçilmedi';const iv=d?.inputs?.find(x=>x?.voltage!=null&&Number.isFinite(+x.voltage))?.voltage,v=d?.voltage!=null?+d.voltage:iv!=null?+iv:null,t=d?.temperature!=null?`${(+d.temperature).toFixed(2)} °C`:'—';$('meta').textContent=d?`Date Time: ${d.lastEventAt?new Date(d.lastEventAt).toLocaleString('tr-TR'):d.lastSeenAt||'—'}, Voltage: ${v==null?'—':v.toFixed(2)+' V'}, Uptime: ${uptime(d.deviceUptimeMs)}, Temperature: ${t}`:'Date Time: —, Voltage: —, Uptime: —, Temperature: —';
for(let i=0;i<4;i++){const s=d?.relays?.[i],o=document.createElement('div');o.className=`io-output ${s===1?'active':''}`;const l=document.createElement('span');l.className='io-output-label';l.textContent=`OUT ${i+1}`;const b=document.createElement('button');b.className=`io-switch ${s===1?'active':''}`;b.disabled=!d||!can;b.dataset.relay=i+1;b.dataset.position=s===1?0:1;b.innerHTML=`<span>${s===1?'ON':s===0?'OFF':'—'}</span>`;o.append(l,b);$('relays').append(o);const n=d?.inputs?.[i],x=document.createElement('div');x.className=`io-input ${n?.io===1?'active':''}`;const nl=document.createElement('span');nl.className='io-input-label';nl.textContent=n?.name||`INP${i+1}`;const bar=document.createElement('span');bar.className='io-input-bar';const small=document.createElement('small');small.textContent=`${n?.io===1?'ON':n?.io===0?'OFF':'—'} · ${n?.voltage!=null?(+n.voltage).toFixed(2)+' V':'Voltaj —'}`;x.append(nl,bar,small);$('inputs').append(x)}if(!d?.lastJson){$('json').setAttribute('data-i18n-translate','');$('json').textContent='Cihazdan henüz JSON verisi alınmadı.'}else{$('json').removeAttribute('data-i18n-translate');try{$('json').textContent=JSON.stringify(JSON.parse(d.lastJson),null,2)}catch{$('json').textContent=d.lastJson}}}
$('device').onchange=draw;$('restart').onclick=async()=>{const d=clients.find(x=>x.clientId===$('device').value);if(!d||!await netrelayConfirm(`${d.username} cihazı yeniden başlatılsın mı?`,{title:'Cihazı yeniden başlat'}))return;$('restart').disabled=true;$('result').textContent='Yeniden başlatma komutu gönderiliyor...';$('result').className='';socket.send(JSON.stringify({type:'restartDevice',targetClientId:d.clientId}))};$('relays').onclick=e=>{const b=e.target.closest('[data-relay]'),d=clients.find(x=>x.clientId===$('device').value);if(!b||!d)return;socket.send(JSON.stringify({type:'publish',targetClientId:d.clientId,payload:JSON.stringify({type:'netrelay',command:'set',targetUsername:d.username,relays:[+b.dataset.relay],position:+b.dataset.position,delay:0})}));$('result').textContent=`Röle ${b.dataset.relay} komutu gönderildi.`;$('result').className='result-success'};$('copy').onclick=async()=>{try{await netrelayCopyText($('json').textContent);$('result').textContent='JSON kopyalandı.';await netrelayAlert('JSON panoya kopyalandı.','success')}catch{$('result').textContent='Kopyalanamadı.';await netrelayAlert('JSON kopyalanamadı.','error')}};
const baseDraw=draw;draw=()=>{baseDraw();const d=clients.find(x=>x.clientId===$('device').value),can=user?.role==='admin'||user?.permissions?.includes('dashboard');$('sync').disabled=!d||!can};$('device').onchange=draw;$('sync').onclick=()=>{const d=clients.find(x=>x.clientId===$('device').value);if(!d)return;$('sync').disabled=true;$('result').textContent='Güncel durum isteniyor...';$('result').className='';socket.send(JSON.stringify({type:'syncDevice',targetClientId:d.clientId}))};
function render(s){clients=s.onlineClients||[];user=s.currentUser;const selected=$('device').value;$('device').replaceChildren(new Option('Çevrimiçi cihaz seçin',''));clients.forEach(x=>$('device').append(new Option(`${x.username} — ${x.hostname||x.clientId}`,x.clientId)));if([...$('device').options].some(x=>x.value===selected))$('device').value=selected;draw()}
function connect(){socket=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);socket.onopen=()=>{$('socket-status').textContent='Canlı';$('socket-status').className='status online'};socket.onmessage=e=>{const s=JSON.parse(e.data);if(s.type==='state')render(s);if(['restartDeviceSuccess','restartDeviceError','syncDeviceSuccess','syncDeviceError'].includes(s.type)){$('result').textContent=s.message;$('result').className=s.type.endsWith('Success')?'result-success':'result-error';draw()}if(s.type==='publishError'){$('result').textContent=s.message;$('result').className='result-error'}};socket.onclose=()=>{$('socket-status').textContent='Bağlantı kesildi';$('socket-status').className='status offline';setTimeout(connect,2000)}}draw();connect();
</script></body></html>
