<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Panel Kullanıcıları · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="stylesheet" href="/style.css"></head><body><%- include('partials/standalone-sidebar',{activePage:'web-users'}) %>
<main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY SİSTEM</p><h1>Panel Kullanıcıları</h1></div><div class="standalone-nav"><span id="socket-status" class="status offline">Bağlanıyor...</span><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>Kullanıcı tanımı</h2><span>Hesap / parola / yetki yönetimi</span></div><form id="form" class="web-user-form"><input id="id" type="hidden"><label>Kullanıcı adı<input id="username" required></label><label>Görünen ad<input id="name"></label><label>Parola<input id="password" type="password" minlength="8"></label><label>Hesap türü<select id="role"><option value="user">Yetkili kullanıcı</option><option value="admin">Yönetici</option></select></label><fieldset><legend>Bölüm yetkileri</legend><div id="permissions" class="permission-grid"></div></fieldset><label class="toggle-label"><span>Hesap etkin</span><span class="toggle-switch"><input id="enabled" type="checkbox" checked><span class="toggle-slider"></span></span></label><label class="toggle-label"><span>Sonraki girişte parola değiştir</span><span class="toggle-switch"><input id="must-change" type="checkbox" checked><span class="toggle-slider"></span></span></label><div class="send-row"><button class="send-button">Kaydet</button><button id="reset" class="secondary-button" type="button">Yeni kullanıcı</button><span id="result"></span></div></form><div class="table-wrap"><table><thead><tr><th>Kullanıcı</th><th>Tür</th><th>Yetkiler</th><th>Durum</th><th>İşlem</th></tr></thead><tbody id="list"></tbody></table></div></section></main>
<script>
let socket,users=[];const $=id=>document.getElementById(id),labels={dashboard:'Genel bakış ve cihazlar',relay:'Röle komutu',schedules:'Zamanlanmış görevler',firmware:'Firmware güncelleme',email:'E-posta ayarları',blacklist:'MQTT blacklist',logs:'Sunucu logları',users:'Kullanıcı yönetimi'},cell=(r,v)=>{const c=document.createElement('td');c.textContent=v;r.append(c);return c};Object.entries(labels).forEach(([v,l])=>{const x=document.createElement('label');x.className='relay-option';x.innerHTML=`<input class="permission" type="checkbox" value="${v}"> ${l}`;$('permissions').append(x)});
function reset(){ $('form').reset();$('id').value='';$('enabled').checked=true;$('must-change').checked=true;$('password').required=true }$('reset').onclick=reset;$('form').onsubmit=e=>{e.preventDefault();socket.send(JSON.stringify({type:'webUserSave',user:{id:$('id').value||undefined,username:$('username').value,displayName:$('name').value,password:$('password').value,role:$('role').value,permissions:[...document.querySelectorAll('.permission:checked')].map(x=>x.value),enabled:$('enabled').checked,mustChangePassword:$('must-change').checked}}));$('result').textContent='Kaydediliyor...'};
$('list').onclick=e=>{const b=e.target.closest('[data-action]');if(!b)return;const u=users.find(x=>x.id===+b.dataset.id);if(b.dataset.action==='remove'&&confirm(`${u.username} silinsin mi?`))socket.send(JSON.stringify({type:'webUserRemove',id:u.id}));if(b.dataset.action==='edit'){$('id').value=u.id;$('username').value=u.username;$('name').value=u.displayName;$('password').value='';$('password').required=false;$('role').value=u.role;$('enabled').checked=u.enabled;$('must-change').checked=u.mustChangePassword;document.querySelectorAll('.permission').forEach(x=>x.checked=u.permissions.includes(x.value));scrollTo({top:0,behavior:'smooth'})}};
function render(s){users=s.webUsers||[];$('list').replaceChildren();users.forEach(u=>{const r=document.createElement('tr'),n=cell(r,u.displayName||u.username);n.append(Object.assign(document.createElement('small'),{textContent:u.username}));cell(r,u.role==='admin'?'Yönetici':'Kullanıcı');cell(r,u.role==='admin'?'Tümü':u.permissions.map(x=>labels[x]||x).join(', ')||'Yetki yok');cell(r,u.enabled?(u.mustChangePassword?'Etkin / parola değişecek':'Etkin'):'Pasif');const a=cell(r,'');[['edit','Düzenle'],['remove','Sil']].forEach(([x,l])=>{const b=document.createElement('button');b.className=x==='remove'?'danger-button compact':'secondary-button';b.dataset.action=x;b.dataset.id=u.id;b.textContent=l;a.append(b)});$('list').append(r)})}
function connect(){socket=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);socket.onopen=()=>{$('socket-status').textContent='Canlı';$('socket-status').className='status online'};socket.onmessage=e=>{const s=JSON.parse(e.data);if(s.type==='state')render(s);if(s.type==='webUserSuccess'||s.type==='webUserError'){$('result').textContent=s.message;$('result').className=s.type.endsWith('Success')?'result-success':'result-error';if(s.type.endsWith('Success'))reset()}};socket.onclose=()=>{$('socket-status').textContent='Bağlantı kesildi';$('socket-status').className='status offline';setTimeout(connect,2000)}}reset();connect();
</script></body></html>
