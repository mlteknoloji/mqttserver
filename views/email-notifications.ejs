<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>E-posta Bildirimleri · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="stylesheet" href="/style.css"></head><body><%- include('partials/standalone-sidebar',{activePage:'email-notifications'}) %>
<main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY BİLDİRİM</p><h1>E-posta Bildirimleri</h1></div><div class="standalone-nav"><span id="socket-status" class="status offline">Bağlanıyor...</span><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>SMTP ayarları</h2><span>Cihaz aktif / pasif bildirimleri</span></div><form id="settings" class="email-settings-form"><label>SMTP sunucusu<input id="host" required></label><label>Port<input id="port" type="number" min="1" max="65535" required value="587"></label><label>Kullanıcı adı<input id="username"></label><label>Parola<input id="password" type="password" placeholder="Değiştirmemek için boş bırakın"></label><label>Gönderen<input id="sender" required></label><label>Genel alıcılar<input id="recipients" required placeholder="yonetici@example.com"></label><label class="toggle-label"><span>SSL/TLS</span><span class="toggle-switch"><input id="secure" type="checkbox"><span class="toggle-slider"></span></span></label><label class="toggle-label"><span>Bildirimler etkin</span><span class="toggle-switch"><input id="enabled" type="checkbox"><span class="toggle-slider"></span></span></label><div class="send-row"><button class="send-button">Kaydet</button><button id="test" class="secondary-button" type="button">Test e-postası</button><span id="result"></span></div></form>
<form id="monitor" class="email-monitor-form"><label>MQTT kullanıcısı<input id="monitor-user" required list="users"></label><datalist id="users"></datalist><label>Şube / cihaz adı<input id="monitor-name"></label><label>Şubeye özel alıcılar<input id="monitor-recipients" placeholder="sube@example.com, teknik@example.com"></label><button class="send-button">İzlemeye ekle</button></form><div class="table-wrap"><table><thead><tr><th>MQTT kullanıcısı</th><th>Şube / cihaz</th><th>Alıcılar</th><th>Durum</th><th>İşlem</th></tr></thead><tbody id="list"></tbody></table><p id="empty" class="empty">İzlenen cihaz yok.</p></div></section></main>
<script>
let socket,monitors=[];const $=id=>document.getElementById(id),cell=(r,v)=>{const c=document.createElement('td');c.textContent=v;r.append(c);return c};$('settings').onsubmit=e=>{e.preventDefault();socket.send(JSON.stringify({type:'emailSettingsSave',settings:{host:$('host').value,port:+$('port').value,username:$('username').value,password:$('password').value,sender:$('sender').value,recipients:$('recipients').value,secure:$('secure').checked,enabled:$('enabled').checked}}));$('result').textContent='Kaydediliyor...'};$('test').onclick=()=>{socket.send(JSON.stringify({type:'emailSendTest'}));$('result').textContent='Gönderiliyor...'};$('monitor').onsubmit=e=>{e.preventDefault();socket.send(JSON.stringify({type:'emailMonitorSave',monitor:{username:$('monitor-user').value,displayName:$('monitor-name').value,recipients:$('monitor-recipients').value,enabled:true}}));e.target.reset()};
$('list').onclick=e=>{const b=e.target.closest('[data-action]');if(!b)return;const m=monitors.find(x=>x.username===b.dataset.user);if(b.dataset.action==='toggle')socket.send(JSON.stringify({type:'emailMonitorEnabled',username:m.username,enabled:!m.enabled}));if(b.dataset.action==='remove'&&confirm('İzleme kaydı kaldırılsın mı?'))socket.send(JSON.stringify({type:'emailMonitorRemove',username:m.username}))};
function render(s){const state=s.emailNotifications||{settings:{},monitors:[]},x=state.settings||{};$('host').value=x.host||'';$('port').value=x.port||587;$('username').value=x.username||'';$('password').value='';$('password').placeholder=x.hasPassword?'Parola kayıtlı; değiştirmek için yazın':'SMTP parolası';$('sender').value=x.sender||'';$('recipients').value=x.recipients||'';$('secure').checked=x.secure===true;$('enabled').checked=x.enabled===true;$('users').replaceChildren(...[...new Set(s.onlineClients.map(c=>c.username))].map(u=>new Option(u)));monitors=state.monitors||[];$('list').replaceChildren();$('empty').classList.toggle('hidden',monitors.length>0);monitors.forEach(m=>{const r=document.createElement('tr');cell(r,m.username);cell(r,m.displayName||'—');cell(r,m.recipients||'Genel alıcılar');cell(r,m.enabled?'İzleniyor':'Devre dışı');const a=cell(r,'');[['toggle',m.enabled?'Devre dışı':'Etkinleştir'],['remove','Kaldır']].forEach(([x,l])=>{const b=document.createElement('button');b.className=x==='remove'?'danger-button compact':'secondary-button';b.dataset.action=x;b.dataset.user=m.username;b.textContent=l;a.append(b)});$('list').append(r)})}
function connect(){socket=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);socket.onopen=()=>{$('socket-status').textContent='Canlı';$('socket-status').className='status online'};socket.onmessage=e=>{const s=JSON.parse(e.data);if(s.type==='state')render(s);if(s.type==='emailNotificationSuccess'||s.type==='emailNotificationError'){$('result').textContent=s.message;$('result').className=s.type.endsWith('Success')?'result-success':'result-error'}};socket.onclose=()=>{$('socket-status').textContent='Bağlantı kesildi';$('socket-status').className='status offline';setTimeout(connect,2000)}}connect();
</script></body></html>
