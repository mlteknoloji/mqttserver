<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Parola Değiştir</title><link rel="stylesheet" href="/style.css"></head>
<body class="auth-page"><main class="auth-card card"><div class="sidebar-brand"><span>NETRELAY</span><strong>İlk giriş güvenliği</strong></div><h1>Parolanızı değiştirin</h1><p><strong><%= user.username %></strong> hesabıyla devam etmek için en az 8 karakterli yeni bir parola belirleyin.</p>
<% if (error) { %><div class="auth-error"><%= error %></div><% } %>
<form method="post" action="/change-password"><label>Mevcut parola<input name="currentPassword" type="password" autocomplete="current-password" required autofocus></label><label>Yeni parola<input name="newPassword" type="password" minlength="8" autocomplete="new-password" required></label><label>Yeni parola tekrar<input name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required></label><button class="send-button" type="submit">Parolayı değiştir</button></form></main></body></html>
