<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kural Motoru · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/style.css"></head><body><%- include('partials/standalone-sidebar',{activePage:'automation-rules'}) %><main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY OTOMASYON</p><h1>Kural Motoru</h1></div><div class="standalone-nav"><span id="socket-status" class="status offline">Bağlanıyor...</span><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>Kural tanımı</h2><span>Koşul gerçekleştiğinde seçilen eylemler sırayla çalışır</span></div><form id="form" class="rule-form"><input id="id" type="hidden"><label>Kural adı<input id="name" required maxlength="100"></label><label>Kaynak MQTT kullanıcısı<input id="source" required list="devices"></label><datalist id="devices"></datalist><label>Tetikleyici<select id="trigger"><option value="input">Input</option><option value="temperature">Sıcaklık</option><option value="voltage">Voltaj</option></select></label><label id="channel-label">Input kanalı<select id="channel"><option value="1">Input 1</option><option value="2">Input 2</option><option value="3">Input 3</option><option value="4">Input 4</option></select></label><label>Karşılaştırma<select id="operator"><option value="eq">Eşitse (=)</option><option value="ne">Eşit değilse (≠)</option><option value="gt">Büyükse (&gt;)</option><option value="gte">Büyük/eşitse (≥)</option><option value="lt">Küçükse (&lt;)</option><option value="lte">Küçük/eşitse (≤)</option></select></label><label>Değer<input id="threshold" type="number" step="0.01" value="1" required></label><label>Tekrar bekleme (sn)<input id="cooldown" type="number" min="0" max="86400" value="60"></label><label class="toggle-label"><span>Kural aktif</span><span class="toggle-switch"><input id="enabled" type="checkbox" checked><span class="toggle-slider"></span></span></label>
<fieldset><legend>Eylemler</legend><div class="rule-actions"><label class="toggle-label"><input id="relay-on" type="checkbox"> Röle konumu değiştir</label><div id="relay-fields" class="action-fields hidden"><label>Hedef kullanıcı<input id="relay-target" list="devices"></label><fieldset><legend>Röleler</legend><div class="relay-options"><label><input class="relay" type="checkbox" value="1"> 1</label><label><input class="relay" type="checkbox" value="2"> 2</label><label><input class="relay" type="checkbox" value="3"> 3</label><label><input class="relay" type="checkbox" value="4"> 4</label></div></fieldset><label>Konum<select id="position"><option value="1">Aç / 1</option><option value="0">Kapat / 0</option></select></label><label>Eski konuma dönme (sn, 0=kapalı)<input id="delay" type="number" min="0" value="0"></label></div><label class="toggle-label"><input id="email-on" type="checkbox"> E-posta gönder</label><div id="email-fields" class="action-fields hidden"><label>Alıcılar<input id="email-recipients" placeholder="teknik@example.com"></label><label>Konu<input id="email-subject" placeholder="NetRelay kuralı: {{rule}}"></label><label>Mesaj<textarea id="email-message" rows="3" placeholder="{{device}} değeri {{value}} oldu. {{time}}"></textarea></label></div><label class="toggle-label"><input id="sms-on" type="checkbox"> Netgsm SMS gönder</label><div id="sms-fields" class="action-fields hidden"><label>Telefonlar<input id="sms-recipients" placeholder="5XXXXXXXXX, 5XXXXXXXXX"></label><label>Mesaj<textarea id="sms-message" rows="3" maxlength="912" placeholder="{{device}} değeri {{value}} oldu. {{time}}"></textarea></label></div></div></fieldset><div class="send-row"><button class="send-button">Kaydet</button><button id="new-rule" class="secondary-button" type="button">Yeni kural</button><span id="result"></span></div></form><div class="table-wrap"><table><thead><tr><th>Kural</th><th>Koşul</th><th>Eylemler</th><th>Sonuç</th><th>İşlem</th></tr></thead><tbody id="list"></tbody></table></div><p id="empty" class="empty">Henüz kural yok.</p></section></main>
<script>
let socket,rules=[];const $=id=>document.getElementById(id),cell=(r,v)=>{const c=document.createElement('td');c.textContent=v;r.append(c);return c},toggleFields=()=>{['relay','email','sms'].forEach(x=>$(`${x}-fields`).classList.toggle('hidden',!$(`${x}-on`).checked));$('channel-label').classList.toggle('hidden',$('trigger').value!=='input')};['relay','email','sms'].forEach(x=>$(`${x}-on`).onchange=toggleFields);$('trigger').onchange=toggleFields;
function resetForm(){$('form').reset();$('id').value='';$('enabled').checked=true;$('cooldown').value=60;$('threshold').value=1;toggleFields();$('result').textContent=''}$('new-rule').onclick=resetForm;
$('form').onsubmit=e=>{e.preventDefault();const actions=[];if($('relay-on').checked)actions.push({type:'relay',targetUsername:$('relay-target').value,relays:[...document.querySelectorAll('.relay:checked')].map(x=>+x.value),position:+$('position').value,delay:+$('delay').value});if($('email-on').checked)actions.push({type:'email',recipients:$('email-recipients').value,subject:$('email-subject').value,message:$('email-message').value});if($('sms-on').checked)actions.push({type:'sms',recipients:$('sms-recipients').value,message:$('sms-message').value});socket.send(JSON.stringify({type:'automationRuleSave',rule:{id:$('id').value||undefined,name:$('name').value,sourceUsername:$('source').value,triggerType:$('trigger').value,channel:+$('channel').value,operator:$('operator').value,threshold:+$('threshold').value,cooldownSeconds:+$('cooldown').value,enabled:$('enabled').checked,actions}}));$('result').textContent='Kaydediliyor...'};
$('list').onclick=e=>{const b=e.target.closest('[data-action]');if(!b)return;const r=rules.find(x=>x.id===+b.dataset.id);if(b.dataset.action==='toggle')socket.send(JSON.stringify({type:'automationRuleEnabled',id:r.id,enabled:!r.enabled}));if(b.dataset.action==='remove'&&confirm('Kural silinsin mi?'))socket.send(JSON.stringify({type:'automationRuleRemove',id:r.id}));if(b.dataset.action==='edit'){resetForm();$('id').value=r.id;$('name').value=r.name;$('source').value=r.sourceUsername;$('trigger').value=r.triggerType;$('channel').value=r.channel||1;$('operator').value=r.operator;$('threshold').value=r.threshold;$('cooldown').value=r.cooldownSeconds;$('enabled').checked=r.enabled;for(const a of r.actions){$(`${a.type}-on`).checked=true;if(a.type==='relay'){$('relay-target').value=a.targetUsername;$('position').value=a.position;$('delay').value=a.delay||0;document.querySelectorAll('.relay').forEach(x=>x.checked=a.relays.includes(+x.value))}if(a.type==='email'){$('email-recipients').value=a.recipients;$('email-subject').value=a.subject||'';$('email-message').value=a.message||''}if(a.type==='sms'){$('sms-recipients').value=a.recipients;$('sms-message').value=a.message||''}}toggleFields();scrollTo({top:0,behavior:'smooth'})}};
function render(s){rules=s.automationRules||[];const names=[...new Set([...s.onlineClients.map(x=>x.username),...rules.flatMap(r=>[r.sourceUsername,...r.actions.filter(a=>a.type==='relay').map(a=>a.targetUsername)])])];$('devices').replaceChildren(...names.map(x=>new Option(x)));$('list').replaceChildren();$('empty').classList.toggle('hidden',rules.length>0);rules.forEach(x=>{const r=document.createElement('tr');cell(r,`${x.enabled?'●':'○'} ${x.name}`);cell(r,`${x.sourceUsername} / ${x.triggerType}${x.channel?' '+x.channel:''} ${x.operator} ${x.threshold}`);cell(r,x.actions.map(a=>a.type).join(', '));cell(r,x.lastResult||'Henüz çalışmadı');const a=cell(r,'');[['toggle',x.enabled?'Pasif yap':'Aktif yap'],['edit','Düzenle'],['remove','Sil']].forEach(([k,l])=>{const b=document.createElement('button');b.type='button';b.className=k==='remove'?'danger-button compact':'secondary-button';b.dataset.action=k;b.dataset.id=x.id;b.textContent=l;a.append(b)});$('list').append(r)})}
function connect(){socket=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);socket.onopen=()=>{$('socket-status').textContent='Canlı';$('socket-status').className='status online'};socket.onmessage=e=>{const s=JSON.parse(e.data);if(s.type==='state')render(s);if(s.type==='automationRuleSuccess'||s.type==='automationRuleError'){$('result').textContent=s.message;$('result').className=s.type.endsWith('Success')?'result-success':'result-error';if(s.type.endsWith('Success'))resetForm()}};socket.onclose=()=>setTimeout(connect,2000)}resetForm();connect();
</script></body></html>
