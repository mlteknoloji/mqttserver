          const toggle=document.createElement('button');toggle.type='button';toggle.className=`io-switch ${state===1?'active':''}`;toggle.dataset.ioRelay=index+1;toggle.dataset.ioPosition=state===1?0:1;toggle.disabled=!device||!canControl;toggle.setAttribute('aria-label',`Röle ${index+1} ${state===1?'kapat':'aç'}`);const toggleText=document.createElement('span');toggleText.textContent=state===1?'ON':state===0?'OFF':'—';toggle.appendChild(toggleText);output.append(outputLabel,toggle);ioRelays.appendChild(output);
          const input=device?.inputs?.[index];const inputState=input?.io;const inputItem=document.createElement('div');inputItem.className=`io-input ${inputState===1?'active':''}`;const inputLabel=document.createElement('span');inputLabel.className='io-input-label';inputLabel.textContent=input?.name||`INP${index+1}`;const bar=document.createElement('span');bar.className='io-input-bar';const detail=document.createElement('small');detail.textContent=`${inputState===1?'ON':inputState===0?'OFF':'—'} · ${input?.voltage != null&&Number.isFinite(Number(input.voltage))?`${Number(input.voltage).toFixed(2)} V`:'Voltaj —'}`;inputItem.append(inputLabel,bar,detail);ioInputs.appendChild(inputItem);
        }
        if (!device?.lastJson) { ioRawJson.setAttribute('data-i18n-translate',''); ioRawJson.textContent='Cihazdan henüz JSON verisi alınmadı.'; }
