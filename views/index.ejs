<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MQTT Sunucu Paneli</title>
    <script>
      (() => {
        const saved = localStorage.getItem('netrelay-theme');
        const theme = saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="stylesheet" href="/style.css">
    <%- include('partials/swal-assets') %>
    <script src="/state-delta.js"></script>
    <script src="/form-ui.js" defer></script>
  </head>
  <body>
    <button id="menu-toggle" class="menu-toggle" type="button" aria-label="Menüyü aç" aria-controls="sidebar" aria-expanded="false">☰</button>
    <div id="sidebar-overlay" class="sidebar-overlay"></div>
    <aside id="sidebar" class="sidebar">
      <a class="sidebar-brand" href="/" aria-label="MQTT Sunucu Paneli ana sayfa">
        <span>NETRELAY</span>
        <strong>MQTT Server</strong>
      </a>
      <nav class="sidebar-nav" aria-label="Ana menü">
        <div class="nav-group" data-nav-group="monitoring"><button class="nav-group-title" type="button">İZLEME <span>⌄</span></button><div class="nav-group-items">
          <a class="active" href="#dashboard"><span>⌂</span> Genel Bakış</a><a href="#online-clients"><span>●</span> Çevrimiçi Cihazlar</a><a href="/device-io"><span>⌁</span> Cihaz I/O İzleme</a>
        </div></div>
        <div class="nav-group collapsed" data-nav-group="automation"><button class="nav-group-title" type="button">KONTROL VE OTOMASYON <span>⌄</span></button><div class="nav-group-items">
          <a href="#relay-command"><span>⇄</span> Röle Komutu</a><a href="/scheduled-tasks"><span>◷</span> Zamanlanmış Görevler</a><a href="/firmware-management"><span>⇧</span> Firmware Güncelleme</a>
        </div></div>
        <div class="nav-group collapsed" data-nav-group="security"><button class="nav-group-title" type="button">BİLDİRİM VE GÜVENLİK <span>⌄</span></button><div class="nav-group-items">
          <a href="/email-notifications"><span>✉</span> E-posta Bildirimleri</a><a href="/mqtt-blacklist"><span>⊘</span> MQTT Blacklist</a>
        </div></div>
        <div class="nav-group collapsed" data-nav-group="system"><button class="nav-group-title" type="button">SİSTEM <span>⌄</span></button><div class="nav-group-items">
          <a href="#server-logs"><span>≡</span> Sunucu Logları</a><% if (currentUser.role === 'admin') { %><a href="/web-users"><span>♙</span> Kullanıcı Yönetimi</a><a href="/api-keys"><span>⌘</span> REST API</a><a href="/log-rotation"><span>↻</span> Log Rotasyonu</a><% } %>
        </div></div>
      </nav>
      <div class="sidebar-footer">
        <label class="theme-control" for="theme-toggle">
          <span id="theme-icon">☾</span>
          <span id="theme-label">Karanlık tema</span>
          <span class="toggle-switch"><input id="theme-toggle" type="checkbox"><span class="toggle-slider"></span></span>
        </label>
        <small>NetRelay MQTT yönetimi</small>
      </div>
    </aside>
    <main class="container standalone-shell">
      <header id="dashboard" class="page-section">
        <div>
          <p class="eyebrow">CANLI YÖNETİM EKRANI</p>
          <h1>MQTT Sunucu Paneli</h1>
        </div>
        <div class="header-actions"><span class="signed-user"><%= currentUser.displayName || currentUser.username %><small><%= currentUser.username %></small></span><div id="socket-status" class="status offline">Bağlanıyor...</div><form method="post" action="/logout"><button class="secondary-button" type="submit">Çıkış</button></form></div>
      </header>

      <section id="online-clients" class="card panel page-section">
        <div class="panel-title">
          <h2>Çevrimiçi kullanıcılar</h2>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Durum</th><th>Şube / kullanıcı</th><th>Cihaz</th><th>Uptime</th><th>Son görülme</th></tr>
            </thead>
            <tbody id="online-list">
              <% onlineClients.forEach((client) => { %>
                <tr>
                  <td><span class="status-chip up"><span class="online-dot"></span><%= client.status || 'UP' %></span></td>
                  <td><strong><%= client.hostname || client.username %></strong><small><%= client.username %></small></td>
                  <td><%= client.clientId %><small><%= client.ipAddress || 'IP bekleniyor' %></small></td>
                  <td><%= Math.floor((client.deviceUptimeMs || 0) / 1000) %> sn</td>
                  <td><%= client.lastSeenAt || client.connectedAt %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <p id="empty-users" class="empty <%= onlineClients.length ? 'hidden' : '' %>">
            Şu anda bağlı kullanıcı yok.
          </p>
        </div>
      </section>

      <section id="firmware-management" class="card panel page-section moved-page-section">
        <div class="panel-title"><h2>Firmware güncelleme</h2><span>ESP32 OTA / MQTT komutu / HTTP indirme</span></div>
        <form id="firmware-upload-form" class="firmware-upload-form" enctype="multipart/form-data">
          <label>Firmware .bin<input id="firmware-file" name="firmware" type="file" accept=".bin,application/octet-stream" required></label>
          <label>Sürüm<input id="firmware-version" name="version" required placeholder="S-3.3.5"></label>
          <label>Donanım modeli<input id="firmware-hardware" name="hardware" required value="ESP32-S3/W5500/8MB"></label>
          <label>Not<input id="firmware-notes" name="notes" maxlength="300" placeholder="Sürüm açıklaması"></label>
          <div class="send-row"><button class="send-button" type="submit">Firmware yükle</button><span id="firmware-upload-result"></span></div>
        </form>
        <div class="firmware-start">
          <label>Firmware<select id="firmware-select"><option value="">Firmware seçin</option></select></label>
          <label>Hedef cihaz<select id="firmware-device-select"><option value="">Çevrimiçi cihaz seçin</option></select></label>
          <button id="firmware-start-button" class="danger-button" type="button">Güncellemeyi başlat</button><span id="firmware-result"></span>
        </div>
        <div class="table-wrap"><table><thead><tr><th>Sürüm</th><th>Donanım</th><th>Dosya / Boyut</th><th>SHA-256</th><th>İşlem</th></tr></thead><tbody id="firmware-list"></tbody></table><p id="empty-firmwares" class="empty">Yüklü firmware yok.</p></div>
        <div class="panel-title"><h2>Güncelleme geçmişi</h2><span>Son 100 işlem</span></div>
        <div class="table-wrap"><table><thead><tr><th>Cihaz</th><th>Firmware</th><th>Durum</th><th>İlerleme</th><th>Mesaj / Tarih</th></tr></thead><tbody id="firmware-job-list"></tbody></table><p id="empty-firmware-jobs" class="empty">Henüz güncelleme işlemi yok.</p></div>
      </section>

      <section id="device-io" class="card panel page-section moved-page-section">
        <div class="panel-title"><h2>Cihaz input / output izleme</h2><span>Canlı MQTT JSON verileri ve manuel kontrol</span></div>
        <div class="device-selector"><label>İzlenecek kullanıcı / cihaz<select id="io-device-select"><option value="">Çevrimiçi cihaz seçin</option></select></label><span id="io-last-seen">Cihaz seçilmedi</span></div>
        <div id="io-device-meta" class="io-device-meta">Date Time: —, Voltage: —, Uptime: —, Temperature: —</div>
        <div class="io-visual"><div><h3>Output / röleler</h3><div id="io-relays" class="io-output-grid"></div></div><div><h3>Inputlar</h3><div id="io-inputs" class="io-input-grid"></div></div></div>
        <div class="raw-json"><div><h3>Son gelen cihaz JSON verisi</h3><button id="io-copy-json" class="secondary-button" type="button">JSON kopyala</button></div><pre id="io-raw-json" data-i18n-translate>Cihazdan henüz JSON verisi alınmadı.</pre></div>
        <div class="send-row io-result-row"><span id="io-command-result"></span></div>
      </section>

      <section class="summary">
        <div class="card count-card">
          <span>Çevrimiçi bağlantı</span>
          <strong id="online-count"><%= onlineClients.length %></strong>
        </div>
        <div class="card">
          <span>MQTT adresi</span>
          <strong class="mqtt-address-list"><%= mqttAddresses.join(', ') || 'IP adresi bulunamadı' %></strong>
        </div>
      </section>
      <section class="summary dashboard-history-summary">
        <div class="card"><span>Son 24 saat olay</span><strong id="history-event-count">0</strong></div>
        <div class="card"><span>Bağlantı / kopma (24 saat)</span><strong id="history-connection-count">0 / 0</strong></div>
        <div class="card"><span>Ortalama cihaz uptime</span><strong id="history-average-uptime">—</strong></div>
      </section>

      <section id="relay-command" class="card panel relay-panel page-section">
        <div class="panel-title">
          <h2>NetRelay komutu gönder</h2>
          <span>JSON / MQTT</span>
        </div>
        <div class="relay-form">
          <label>
            Hedef çevrimiçi kullanıcı
            <select id="target-client">
              <% onlineClients.forEach((client) => { %>
                <option value="<%= client.clientId %>" data-username="<%= client.username %>" data-topic="<%= client.commandTopic %>">
                  <%= client.username %> — <%= client.clientId %>
                </option>
              <% }) %>
            </select>
          </label>

          <label>
            Kullanıcıya özel MQTT topic
            <input id="command-topic" readonly>
          </label>

          <fieldset>
            <legend>Tetiklenecek röleler</legend>
            <div class="relay-options relay-ios-grid">
              <% [1, 2, 3, 4].forEach((relay) => { %>
                <label class="relay-ios-option">
                  <input class="relay-checkbox" type="checkbox" value="<%= relay %>">
                  <span class="relay-ios-number"><%= relay %></span>
                  <span class="relay-ios-copy"><strong>Röle <%= relay %></strong><small>Kontrole dahil et</small></span>
                  <span class="relay-ios-switch" aria-hidden="true"></span>
                </label>
              <% }) %>
              <button id="select-all" class="secondary-button relay-select-all" type="button">Tümünü Seç</button>
            </div>
          </fieldset>

          <fieldset>
            <legend>Buton konumu</legend>
            <div class="relay-position-control">
              <label class="relay-position-option relay-position-on"><input type="radio" name="position" value="1" checked><span><strong>AÇIK</strong><small>Konum 1</small></span></label>
              <label class="relay-position-option relay-position-off"><input type="radio" name="position" value="0"><span><strong>KAPALI</strong><small>Konum 0</small></span></label>
            </div>
          </fieldset>

          <label>
            Gecikme (saniye)
            <input id="relay-delay" type="number" min="0" max="4294967" step="1" value="0">
          </label>

          <label>
            <span class="json-field-header"><span>Gönderilecek JSON mesajı</span><button id="copy-json-payload" class="secondary-button compact" type="button">Kopyala</button></span>
            <textarea id="json-payload" rows="8" spellcheck="false"></textarea>
          </label>

          <div class="send-row">
            <button id="send-command" class="send-button" type="button" <%= onlineClients.length ? '' : 'disabled' %>>JSON mesajını gönder</button>
            <span id="send-result"></span>
          </div>
        </div>
      </section>

      <section id="scheduled-tasks" class="card panel page-section moved-page-section">
        <div class="panel-title">
          <h2>Zamanlanmış görevler</h2>
          <span>SQLite / Cron / Güneş zamanları</span>
        </div>
        <form id="schedule-form" class="schedule-form">
          <input id="schedule-id" type="hidden">
          <label>Görev adı<input id="schedule-name" required maxlength="100" placeholder="Bahçe ışıklarını aç"></label>
          <label>Hedef MQTT kullanıcısı<input id="schedule-target" required list="schedule-users" placeholder="şube1"></label>
          <datalist id="schedule-users"></datalist>
          <fieldset><legend>Röleler</legend><div class="relay-options">
            <% [1, 2, 3, 4].forEach((relay) => { %><label class="relay-option"><input class="schedule-relay" type="checkbox" value="<%= relay %>"> Röle <%= relay %></label><% }) %>
          </div></fieldset>
          <fieldset><legend>Yeni konum</legend><div class="relay-options">
            <label class="relay-option"><input type="radio" name="schedule-position" value="1" checked> 1 (Açık)</label>
            <label class="relay-option"><input type="radio" name="schedule-position" value="0"> 0 (Kapalı)</label>
          </div></fieldset>
          <label>Çalışma biçimi<select id="schedule-mode"><option value="cron">Cron saati</option><option value="sunrise">Gün doğumu</option><option value="sunset">Gün batımı</option></select></label>
          <label>Eski konuma dön (saniye, 0 = kapalı)<input id="schedule-restore" type="number" min="0" max="4294967" value="0"></label>
          <div id="cron-builder" class="cron-builder">
            <label>Dakika<select id="cron-minute"><option value="*">Her dakika</option><option value="*/5">5 dakikada bir</option><option value="*/10">10 dakikada bir</option><option value="*/15">15 dakikada bir</option><option value="*/30">30 dakikada bir</option></select></label>
            <label>Saat<select id="cron-hour"><option value="*">Her saat</option></select></label>
            <label>Ayın günü<select id="cron-day"><option value="*">Her gün</option></select></label>
            <label>Ay<select id="cron-month"><option value="*">Her ay</option></select></label>
            <label>Haftanın günü<select id="cron-weekday"><option value="*">Her gün</option><option value="1-5">Hafta içi</option><option value="0,6">Hafta sonu</option><option value="1">Pazartesi</option><option value="2">Salı</option><option value="3">Çarşamba</option><option value="4">Perşembe</option><option value="5">Cuma</option><option value="6">Cumartesi</option><option value="0">Pazar</option></select></label>
          </div>
          <label class="cron-value">Oluşturulan cron değeri<input id="schedule-cron" required value="* * * * *" pattern="\S+\s+\S+\s+\S+\s+\S+\s+\S+"></label>
          <div id="solar-fields" class="solar-fields hidden">
            <label>Enlem<input id="schedule-latitude" type="number" min="-90" max="90" step="any" placeholder="41.0082"></label>
            <label>Boylam<input id="schedule-longitude" type="number" min="-180" max="180" step="any" placeholder="28.9784"></label>
            <label>Dakika ekle / çıkar<input id="schedule-solar-offset" type="number" min="-1440" max="1440" value="0"></label>
            <p id="solar-preview" class="solar-preview">Konum girildiğinde saatler hesaplanır.</p>
          </div>
          <label class="toggle-label schedule-enabled"><span>Görev etkin</span><span class="toggle-switch"><input id="schedule-enabled" type="checkbox" checked><span class="toggle-slider"></span></span></label>
          <div class="send-row"><button class="send-button" type="submit">Görevi kaydet</button><button id="schedule-reset" class="secondary-button" type="button">Yeni görev</button><span id="schedule-result"></span></div>
        </form>
        <div class="table-wrap"><table><thead><tr><th>Görev</th><th>Hedef / Röle</th><th>Zaman</th><th>Geri al</th><th>Sonuç</th><th>Durum / İşlem</th></tr></thead><tbody id="schedule-list"></tbody></table><p id="empty-schedules" class="empty">Henüz zamanlanmış görev yok.</p></div>
      </section>

      <section id="email-notifications" class="card panel page-section moved-page-section">
        <div class="panel-title"><h2>E-posta bildirimleri</h2><span>SMTP / cihaz aktif-pasif takibi</span></div>
        <form id="email-settings-form" class="email-settings-form">
          <label>SMTP sunucusu<input id="email-host" required placeholder="smtp.example.com"></label>
          <label>Port<input id="email-port" required type="number" min="1" max="65535" value="587"></label>
          <label>SMTP kullanıcı adı<input id="email-username" autocomplete="username" placeholder="bildirim@example.com"></label>
          <label>SMTP parolası<input id="email-password" type="password" autocomplete="new-password" placeholder="Kaydedilmiş parolayı korumak için boş bırakın"></label>
          <label>Gönderen<input id="email-sender" required placeholder="NetRelay <bildirim@example.com>"></label>
          <label>Alıcılar<input id="email-recipients" required placeholder="yonetici@example.com, teknik@example.com"></label>
          <label class="toggle-label"><span>SSL/TLS (genellikle port 465)</span><span class="toggle-switch"><input id="email-secure" type="checkbox"><span class="toggle-slider"></span></span></label>
          <label class="toggle-label"><span>Bildirimleri etkinleştir</span><span class="toggle-switch"><input id="email-enabled" type="checkbox"><span class="toggle-slider"></span></span></label>
          <div class="send-row"><button class="send-button" type="submit">SMTP ayarlarını kaydet</button><button id="email-test" class="secondary-button" type="button">Test e-postası gönder</button><span id="email-result"></span></div>
        </form>
        <form id="email-monitor-form" class="email-monitor-form">
          <label>İzlenecek MQTT kullanıcısı<input id="email-monitor-username" required list="email-device-users" placeholder="şube1"></label>
          <datalist id="email-device-users"></datalist>
          <label>Cihaz görünen adı<input id="email-monitor-name" maxlength="100" placeholder="Merkez şube röle kartı"></label>
          <label>Şubeye özel alıcılar<input id="email-monitor-recipients" placeholder="sube@example.com, teknik@example.com"></label>
          <button class="send-button" type="submit">Cihazı izlemeye ekle</button>
        </form>
        <div class="table-wrap"><table><thead><tr><th>MQTT kullanıcısı</th><th>Cihaz adı</th><th>Alıcılar</th><th>Durum</th><th>İşlem</th></tr></thead><tbody id="email-monitor-list"></tbody></table><p id="empty-email-monitors" class="empty">E-posta ile izlenen cihaz yok.</p></div>
      </section>

      <section id="mqtt-blacklist" class="card panel page-section moved-page-section">
        <div class="panel-title">
          <h2>MQTT Blacklist</h2>
          <span>SQLite üzerinde kalıcı</span>
        </div>
        <form id="blacklist-form" class="blacklist-form">
          <label>
            IP adresi
            <input id="blacklist-ip" type="text" required placeholder="192.168.1.25">
          </label>
          <label>
            Açıklama
            <input id="blacklist-reason" type="text" maxlength="200" placeholder="Manuel engelleme nedeni">
          </label>
          <button class="danger-button" type="submit">Blacklist'e ekle</button>
          <span id="blacklist-result"></span>
        </form>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>IP adresi</th><th>Neden</th><th>Hatalı giriş</th><th>Engellenme</th><th>Bitiş</th><th>İşlem</th></tr>
            </thead>
            <tbody id="blacklist-list"></tbody>
          </table>
          <p id="empty-blacklist" class="empty">Blacklist boş.</p>
        </div>
      </section>

      <section id="server-logs" class="card panel page-section">
        <div class="panel-title">
          <h2>Sunucu logları</h2>
          <div class="log-controls">
            <span>Son 200 kayıt</span>
            <label class="toggle-label">
              <span>Terminal Konsol Logları</span>
              <span class="toggle-switch">
                <input id="console-log-enabled" type="checkbox">
                <span class="toggle-slider"></span>
              </span>
            </label>
            <label class="toggle-label">
              <span>Ayrıntılı Debug Log</span>
              <span class="toggle-switch">
                <input id="debug-log-enabled" type="checkbox">
                <span class="toggle-slider"></span>
              </span>
            </label>
          </div>
        </div>
        <div id="logs" class="logs">
          <% logs.forEach((log) => { %>
            <div class="log-row">
              <time><%= log.timestamp %></time>
              <span class="badge <%= log.type.toLocaleLowerCase('tr-TR') %>"><%= log.type %></span>
              <p><%= log.message %></p>
            </div>
          <% }) %>
        </div>
      </section>

      <% if (currentUser.role === 'admin') { %>
      <section id="web-users" class="card panel page-section moved-page-section">
        <div class="panel-title"><h2>Panel kullanıcıları</h2><span>Hesap / parola / yetki yönetimi</span></div>
        <form id="web-user-form" class="web-user-form">
          <input id="web-user-id" type="hidden">
          <label>Kullanıcı adı<input id="web-user-username" required placeholder="kullanici@example.com"></label>
          <label>Görünen ad<input id="web-user-display-name" maxlength="100" placeholder="Teknik kullanıcı"></label>
          <label>Parola<input id="web-user-password" type="password" minlength="8" placeholder="Düzenlemede değiştirmemek için boş bırakın"></label>
          <label>Hesap türü<select id="web-user-role"><option value="user">Yetkili kullanıcı</option><option value="admin">Yönetici (tüm yetkiler)</option></select></label>
          <fieldset><legend>Bölüm yetkileri</legend><div id="web-user-permissions" class="permission-grid"></div></fieldset>
          <label class="toggle-label"><span>Hesap etkin</span><span class="toggle-switch"><input id="web-user-enabled" type="checkbox" checked><span class="toggle-slider"></span></span></label>
          <label class="toggle-label"><span>Sonraki girişte parola değiştir</span><span class="toggle-switch"><input id="web-user-must-change" type="checkbox" checked><span class="toggle-slider"></span></span></label>
          <div class="send-row"><button class="send-button" type="submit">Kullanıcıyı kaydet</button><button id="web-user-reset" class="secondary-button" type="button">Yeni kullanıcı</button><span id="web-user-result"></span></div>
        </form>
        <div class="table-wrap"><table><thead><tr><th>Kullanıcı</th><th>Tür</th><th>Yetkiler</th><th>Durum</th><th>İşlem</th></tr></thead><tbody id="web-user-list"></tbody></table></div>
      </section>
      <% } %>
    </main>

    <script>
      const statusElement = document.getElementById('socket-status');
      const onlineCount = document.getElementById('online-count');
      const onlineList = document.getElementById('online-list');
      const emptyUsers = document.getElementById('empty-users');
      const logsElement = document.getElementById('logs');
      const targetClientElement = document.getElementById('target-client');
      const topicElement = document.getElementById('command-topic');
      const payloadElement = document.getElementById('json-payload');
      const relayDelayElement = document.getElementById('relay-delay');
      const relayCheckboxes = [...document.querySelectorAll('.relay-checkbox')];
      const sendResult = document.getElementById('send-result');
      const blacklistList = document.getElementById('blacklist-list');
      const emptyBlacklist = document.getElementById('empty-blacklist');
      const blacklistResult = document.getElementById('blacklist-result');
      const menuToggle = document.getElementById('menu-toggle');
      const sidebar = document.getElementById('sidebar');
      const sidebarOverlay = document.getElementById('sidebar-overlay');
      const menuLinks = [...document.querySelectorAll('.sidebar-nav a')];
      const debugLogEnabled = document.getElementById('debug-log-enabled');
      const consoleLogEnabled = document.getElementById('console-log-enabled');
      const themeToggle = document.getElementById('theme-toggle');
      const themeLabel = document.getElementById('theme-label');
      const themeIcon = document.getElementById('theme-icon');
      const emailResult = document.getElementById('email-result');
      const emailMonitorList = document.getElementById('email-monitor-list');
