      function formatUptime(milliseconds) {
        const totalSeconds = Math.floor((milliseconds || 0) / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        return [days ? `${days}g` : '', hours ? `${hours}sa` : '', minutes ? `${minutes}dk` : '', `${seconds}sn`]
          .filter(Boolean)
          .join(' ');
      }

      function render(state) {
        signedInUser = state.currentUser;
        latestOnlineClients = state.onlineClients;
        applyPermissions(state.currentUser);
        debugLogEnabled.checked = state.debugLoggingEnabled === true;
        consoleLogEnabled.checked = state.consoleLoggingEnabled === true;
        onlineCount.textContent = state.onlineClients.length;
        const historyStats=state.historyStats||{events:0,connections:{},averageUptimeMs:0};
        document.getElementById('history-event-count').textContent=historyStats.events||0;
        document.getElementById('history-connection-count').textContent=`${historyStats.connections?.connected||0} / ${historyStats.connections?.disconnected||0}`;
        document.getElementById('history-average-uptime').textContent=formatUptime(historyStats.averageUptimeMs||0);
        onlineList.replaceChildren();
        emptyUsers.classList.toggle('hidden', state.onlineClients.length > 0);

        const selectedClientId = targetClientElement.value;
        targetClientElement.replaceChildren();

        for (const client of state.onlineClients) {
          const row = document.createElement('tr');
          const statusCell = addCell(row, '');
          const statusChip = document.createElement('span');
          statusChip.className = `status-chip ${client.status === 'STALE' ? 'stale' : 'up'}`;
          const dot = document.createElement('span');
          dot.className = 'online-dot';
          statusChip.append(dot, document.createTextNode(client.status || 'UP'));
          statusCell.appendChild(statusChip);

          const userCell = addCell(row, '');
          const displayName = document.createElement('strong');
          displayName.textContent = client.hostname || client.username;
          const username = document.createElement('small');
          username.textContent = client.username;
          userCell.append(displayName, username);

          const deviceCell = addCell(row, client.clientId);
          const ip = document.createElement('small');
          ip.textContent = client.ipAddress || 'IP bekleniyor';
          deviceCell.appendChild(ip);
          addCell(row, formatUptime(client.deviceUptimeMs));
          addCell(row, client.lastSeenAt || client.connectedAt);
          onlineList.appendChild(row);

          const option = document.createElement('option');
          option.value = client.clientId;
          option.dataset.username = client.username;
          option.dataset.topic = client.commandTopic;
          option.textContent = `${client.username} — ${client.clientId}`;
          targetClientElement.appendChild(option);
        }

        if ([...targetClientElement.options].some((option) => option.value === selectedClientId)) {
          targetClientElement.value = selectedClientId;
        }
        document.getElementById('send-command').disabled = state.onlineClients.length === 0;
        updatePayload();

        const selectedIoClient=ioDeviceSelect.value; ioDeviceSelect.replaceChildren(new Option('Çevrimiçi cihaz seçin',''));
        for(const client of state.onlineClients){const option=new Option(`${client.username} — ${client.hostname||client.clientId}`,client.clientId);ioDeviceSelect.appendChild(option)}
        if([...ioDeviceSelect.options].some((option)=>option.value===selectedIoClient))ioDeviceSelect.value=selectedIoClient; renderDeviceIo();

        scheduledTasks = state.scheduledTasks || [];
        const users = document.getElementById('schedule-users'); users.replaceChildren();
        [...new Set(state.onlineClients.map((client) => client.username))].forEach((username) => users.appendChild(new Option(username)));
        scheduleList.replaceChildren();
        document.getElementById('empty-schedules').classList.toggle('hidden', scheduledTasks.length > 0);
        for (const task of scheduledTasks) {
          const row = document.createElement('tr');
          const name = addCell(row, task.name); name.appendChild(Object.assign(document.createElement('small'), { textContent: `#${task.id}` }));
          addCell(row, `${task.targetUsername} / ${task.relays.join(', ')}`);
          addCell(row, task.mode === 'cron' ? task.cron : `${task.mode === 'sunrise' ? 'Gün doğumu' : 'Gün batımı'} ${task.solarOffsetMinutes >= 0 ? '+' : ''}${task.solarOffsetMinutes} dk`);
          addCell(row, task.restoreSeconds ? `${task.restoreSeconds} sn` : 'Kapalı');
          const last = addCell(row, task.lastResult || 'Henüz çalışmadı'); if (task.lastRunAt) last.appendChild(Object.assign(document.createElement('small'), { textContent: new Date(task.lastRunAt).toLocaleString('tr-TR') }));
          const actions = addCell(row, ''); const wrap = document.createElement('div'); wrap.className = 'schedule-actions';
          [['toggle', task.enabled ? 'Devre dışı bırak' : 'Etkinleştir'], ['edit','Düzenle'], ['remove','Sil']].forEach(([action,label]) => { const button=document.createElement('button'); button.type='button'; button.className=action==='remove'?'danger-button compact':'secondary-button'; button.dataset.taskAction=action; button.dataset.taskId=task.id; button.textContent=label; wrap.appendChild(button); });
          actions.appendChild(wrap); scheduleList.appendChild(row);
        }

        const emailState = state.emailNotifications || { settings: {}, monitors: [] };
        const emailSettings = emailState.settings || {};
        document.getElementById('email-host').value = emailSettings.host || '';
        document.getElementById('email-port').value = emailSettings.port || 587;
        document.getElementById('email-username').value = emailSettings.username || '';
        document.getElementById('email-password').value = '';
        document.getElementById('email-password').placeholder = emailSettings.hasPassword ? 'Parola kayıtlı; değiştirmek için yazın' : 'SMTP parolası';
        document.getElementById('email-sender').value = emailSettings.sender || '';
        document.getElementById('email-recipients').value = emailSettings.recipients || '';
        document.getElementById('email-secure').checked = emailSettings.secure === true;
        document.getElementById('email-enabled').checked = emailSettings.enabled === true;
        const emailUsers = document.getElementById('email-device-users'); emailUsers.replaceChildren();
        [...new Set(state.onlineClients.map((client) => client.username))].forEach((username) => emailUsers.appendChild(new Option(username)));
        emailMonitorList.replaceChildren();
        document.getElementById('empty-email-monitors').classList.toggle('hidden', emailState.monitors.length > 0);
        for (const monitor of emailState.monitors) {
          const row = document.createElement('tr'); addCell(row, monitor.username); addCell(row, monitor.displayName || '—');
          addCell(row, monitor.recipients || 'Genel alıcılar');
          addCell(row, monitor.enabled ? 'İzleniyor' : 'Devre dışı');
          const cell = addCell(row, ''); const wrap = document.createElement('div'); wrap.className = 'schedule-actions';
          [['toggle', monitor.enabled ? 'Devre dışı bırak' : 'Etkinleştir'], ['remove', 'Kaldır']].forEach(([action,label]) => { const button=document.createElement('button'); button.type='button'; button.className=action==='remove'?'danger-button compact':'secondary-button'; button.dataset.emailAction=action; button.dataset.emailUsername=monitor.username; button.dataset.emailEnabled=monitor.enabled; button.textContent=label; wrap.appendChild(button); });
          cell.appendChild(wrap); emailMonitorList.appendChild(row);
        }

        const firmwareState=state.firmwareManagement||{firmwares:[],jobs:[]};firmwares=firmwareState.firmwares||[];
        const firmwareSelect=document.getElementById('firmware-select'),firmwareDeviceSelect=document.getElementById('firmware-device-select');const selectedFirmware=firmwareSelect.value,selectedFirmwareDevice=firmwareDeviceSelect.value;
        firmwareSelect.replaceChildren(new Option('Firmware seçin',''));firmwareDeviceSelect.replaceChildren(new Option('Çevrimiçi cihaz seçin',''));
        firmwares.forEach((item)=>firmwareSelect.appendChild(new Option(`${item.version} — ${item.hardware}`,item.id)));state.onlineClients.forEach((client)=>firmwareDeviceSelect.appendChild(new Option(`${client.username} — ${client.hostname||client.clientId}`,client.clientId)));
        if([...firmwareSelect.options].some((option)=>option.value===selectedFirmware))firmwareSelect.value=selectedFirmware;if([...firmwareDeviceSelect.options].some((option)=>option.value===selectedFirmwareDevice))firmwareDeviceSelect.value=selectedFirmwareDevice;
        const firmwareList=document.getElementById('firmware-list');firmwareList.replaceChildren();document.getElementById('empty-firmwares').classList.toggle('hidden',firmwares.length>0);
        firmwares.forEach((item)=>{const row=document.createElement('tr');addCell(row,item.version);addCell(row,item.hardware);const file=addCell(row,`${(item.size/1024/1024).toFixed(2)} MB`);file.appendChild(Object.assign(document.createElement('small'),{textContent:item.originalName}));const sha=addCell(row,item.sha256);sha.className='sha-cell';const action=addCell(row,'');const button=document.createElement('button');button.type='button';button.className='danger-button compact';button.dataset.firmwareRemove=item.id;button.textContent='Sil';action.appendChild(button);firmwareList.appendChild(row)});
        const jobs=firmwareState.jobs||[],jobList=document.getElementById('firmware-job-list');jobList.replaceChildren();document.getElementById('empty-firmware-jobs').classList.toggle('hidden',jobs.length>0);
        jobs.forEach((job)=>{const row=document.createElement('tr');addCell(row,job.targetUsername);addCell(row,firmwares.find((item)=>item.id===job.firmwareId)?.version||`#${job.firmwareId}`);addCell(row,job.status);const progressCell=addCell(row,`${job.progress}%`);const progress=document.createElement('div');progress.className='firmware-progress';const bar=document.createElement('span');bar.style.width=`${job.progress}%`;progress.appendChild(bar);progressCell.appendChild(progress);const message=addCell(row,job.message||'—');message.appendChild(Object.assign(document.createElement('small'),{textContent:new Date(job.updatedAt).toLocaleString('tr-TR')}));jobList.appendChild(row)});

        if (webUserList) {
          webUsers=state.webUsers || []; webUserList.replaceChildren();
          for(const user of webUsers){const row=document.createElement('tr'); const name=addCell(row,user.displayName||user.username); name.appendChild(Object.assign(document.createElement('small'),{textContent:user.username})); addCell(row,user.role==='admin'?'Yönetici':'Kullanıcı'); addCell(row,user.role==='admin'?'Tümü':user.permissions.map((item)=>permissionLabels[item]||item).join(', ')||'Yetki yok'); addCell(row,user.enabled?(user.mustChangePassword?'Etkin / parola değişecek':'Etkin'):'Pasif'); const cell=addCell(row,''); const wrap=document.createElement('div');wrap.className='schedule-actions';[['edit','Düzenle'],['remove','Sil']].forEach(([action,label])=>{const button=document.createElement('button');button.type='button';button.className=action==='remove'?'danger-button compact':'secondary-button';button.dataset.userAction=action;button.dataset.userId=user.id;button.textContent=label;wrap.appendChild(button)});cell.appendChild(wrap);webUserList.appendChild(row);}
        }

        blacklistList.replaceChildren();
        emptyBlacklist.classList.toggle('hidden', state.blacklist.length > 0);
        for (const entry of state.blacklist) {
          const row = document.createElement('tr');
          addCell(row, entry.ip);
          addCell(row, entry.reason);
          addCell(row, entry.failedAttempts);
          addCell(row, new Date(entry.bannedAt).toLocaleString('tr-TR'));
          addCell(row, entry.expiresAt ? new Date(entry.expiresAt).toLocaleString('tr-TR') : 'Süresiz');
          const actionCell = addCell(row, '');
          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.className = 'danger-button compact';
          removeButton.dataset.removeIp = entry.ip;
          removeButton.textContent = 'Kaldır';
          actionCell.appendChild(removeButton);
          blacklistList.appendChild(row);
        }

        logsElement.replaceChildren();
        for (const log of state.logs) {
          const row = document.createElement('div');
          row.className = 'log-row';

          const time = document.createElement('time');
          time.textContent = log.timestamp;
          const badge = document.createElement('span');
          badge.className = `badge ${log.type.toLocaleLowerCase('tr-TR')}`;
          badge.textContent = log.type;
          const message = document.createElement('p');
          message.textContent = log.message;

          row.append(time, badge, message);
          logsElement.appendChild(row);
        }
      }

      function connectWebSocket() {
        const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
        socket = new WebSocket(`${protocol}//${location.host}`);

        socket.addEventListener('open', () => {
          statusElement.textContent = 'Canlı bağlantı aktif';
          statusElement.className = 'status online';
        });

        socket.addEventListener('message', (event) => {
          const state = JSON.parse(event.data);
          if (state.type === 'state') render(state);
          if (state.type === 'publishError') {
            sendResult.textContent = state.message;
            sendResult.className = 'result-error';
            ioCommandResult.textContent = state.message;
            ioCommandResult.className = 'result-error';
          }
          if (state.type === 'blacklistSuccess' || state.type === 'blacklistError') {
            blacklistResult.textContent = state.message;
            blacklistResult.className = state.type === 'blacklistSuccess' ? 'result-success' : 'result-error';
          }
          if (state.type === 'scheduledTaskSuccess' || state.type === 'scheduledTaskError') {
            if (state.type === 'scheduledTaskSuccess') resetScheduleForm();
            scheduleResult.textContent = state.message;
            scheduleResult.className = state.type === 'scheduledTaskSuccess' ? 'result-success' : 'result-error';
          }
          if (state.type === 'emailNotificationSuccess' || state.type === 'emailNotificationError') {
            emailResult.textContent = state.message;
            emailResult.className = state.type === 'emailNotificationSuccess' ? 'result-success' : 'result-error';
          }
          if (state.type === 'webUserSuccess' || state.type === 'webUserError') {
            const result=document.getElementById('web-user-result'); if(result){result.textContent=state.message;result.className=state.type==='webUserSuccess'?'result-success':'result-error';}
          }
          if (state.type === 'firmwareError') { const result=document.getElementById('firmware-result');result.textContent=state.message;result.className='result-error'; }
        });

        socket.addEventListener('close', () => {
          statusElement.textContent = 'Bağlantı kesildi';
          statusElement.className = 'status offline';
          setTimeout(connectWebSocket, 2000);
        });
      }

      updatePayload();
      updateCron();
      updateSolar();
      connectWebSocket();
    </script>
  </body>
</html>
