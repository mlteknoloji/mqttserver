      function updateSolar() {
        const solar = scheduleMode.value !== 'cron';
        document.getElementById('solar-fields').classList.toggle('hidden', !solar);
        document.getElementById('cron-builder').classList.toggle('hidden', solar);
        const lat = Number(document.getElementById('schedule-latitude').value);
        const lon = Number(document.getElementById('schedule-longitude').value);
        if (!solar || !Number.isFinite(lat) || !Number.isFinite(lon)) return;
        // Ön izleme yaklaşık tarayıcı hesabıdır; kesin çalışma zamanı sunucuda aynı konumla hesaplanır.
        const rad = Math.PI / 180, now = new Date(), start = new Date(now.getFullYear(), 0, 0);
        const day = Math.floor((now - start) / 86400000), gamma = 2 * Math.PI / 365 * (day - 1),
          eq = 229.18 * (0.000075 + 0.001868*Math.cos(gamma) - 0.032077*Math.sin(gamma) - 0.014615*Math.cos(2*gamma) - 0.040849*Math.sin(2*gamma)),
          decl = 0.006918 - 0.399912*Math.cos(gamma) + 0.070257*Math.sin(gamma) - 0.006758*Math.cos(2*gamma) + 0.000907*Math.sin(2*gamma),
          angle = Math.acos(Math.cos(90.833*rad)/(Math.cos(lat*rad)*Math.cos(decl))-Math.tan(lat*rad)*Math.tan(decl)),
          noon = 720 - 4*lon - eq - now.getTimezoneOffset(), offset = Number(document.getElementById('schedule-solar-offset').value || 0),
          minutes = noon + (scheduleMode.value === 'sunrise' ? -4*angle/rad : 4*angle/rad) + offset;
        document.getElementById('solar-preview').textContent = `${scheduleMode.value === 'sunrise' ? 'Gün doğumu' : 'Gün batımı'}: ${String(Math.floor(minutes/60)%24).padStart(2,'0')}:${String(Math.round(minutes)%60).padStart(2,'0')} (bugün, yaklaşık)`;
      }
      scheduleMode.addEventListener('change', updateSolar);
      ['schedule-latitude','schedule-longitude','schedule-solar-offset'].forEach((id) => document.getElementById(id).addEventListener('input', updateSolar));

