<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MQTT Kullanıcıları · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="stylesheet" href="/style.css"></head><body><%- include('partials/standalone-sidebar',{activePage:'mqtt-users'}) %>
<main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY MQTT</p><h1>MQTT Kullanıcıları</h1></div><div class="standalone-nav"><span id="socket-status" class="status offline">Bağlanıyor...</span><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>MQTT hesap tanımı</h2><span>Cihaz bağlantı hesabı / parola / durum yönetimi</span></div><form id="form" class="web-user-form mqtt-user-form"><input id="id" type="hidden"><label>Kullanıcı adı<input id="username" required maxlength="100" autocomplete="off"></label><label><span class="field-label">Parola <button type="button" class="help-tooltip" aria-label="Düzenlemede boş bırakırsanız mevcut parola korunur." data-tooltip="Düzenlemede boş bırakırsanız mevcut parola korunur.">i</button></span><input id="password" type="password" minlength="8" autocomplete="new-password"></label><label class="toggle-label mqtt-active-toggle"><span class="sr-only">Hesap aktif</span><span class="toggle-switch bs-tooltip-trigger" tabindex="0" aria-label="Hesap aktif" data-tooltip="Hesap aktif"><input id="enabled" type="checkbox" checked><span class="toggle-slider"></span></span></label><div class="send-row"><button class="send-button">Kaydet</button><button id="new-user" class="secondary-button" type="button">Yeni kullanıcı</button><span id="result"></span></div></form><div class="table-wrap"><table><thead><tr><th>Kullanıcı</th><th>Durum</th><th>Oluşturulma</th><th>İşlem</th></tr></thead><tbody id="list"></tbody></table></div><p id="empty" class="empty">Henüz MQTT kullanıcısı yok.</p></section></main>
<script>
let socket,users=[];const $=id=>document.getElementById(id),cell=(r,v)=>{const c=document.createElement('td');c.textContent=v;r.append(c);return c};
function resetForm(){ $('form').reset();$('id').value='';$('enabled').checked=true;$('password').required=true;$('result').textContent='' }$('new-user').onclick=resetForm;
$('form').onsubmit=e=>{e.preventDefault();socket.send(JSON.stringify({type:'mqttUserSave',user:{id:$('id').value||undefined,username:$('username').value,password:$('password').value,enabled:$('enabled').checked}}));$('result').textContent='Kaydediliyor...'};
$('list').onclick=e=>{const b=e.target.closest('[data-action]');if(!b)return;const u=users.find(x=>x.id===+b.dataset.id);if(b.dataset.action==='toggle')socket.send(JSON.stringify({type:'mqttUserEnabled',id:u.id,enabled:!u.enabled}));if(b.dataset.action==='remove'&&confirm(`${u.username} MQTT kullanıcısı silinsin mi?`))socket.send(JSON.stringify({type:'mqttUserRemove',id:u.id}));if(b.dataset.action==='edit'){$('id').value=u.id;$('username').value=u.username;$('password').value='';$('password').required=false;$('enabled').checked=u.enabled;scrollTo({top:0,behavior:'smooth'})}};
function render(s){users=s.mqttUsers||[];$('list').replaceChildren();$('empty').classList.toggle('hidden',users.length>0);users.forEach(u=>{const r=document.createElement('tr');cell(r,u.username);const status=cell(r,'');const toggle=document.createElement('label');toggle.className='toggle-switch';toggle.title=u.enabled?'Hesabı pasif yap':'Hesabı aktif yap';toggle.innerHTML=`<input type="checkbox" data-action="toggle" data-id="${u.id}" ${u.enabled?'checked':''}><span class="toggle-slider"></span>`;status.append(toggle);cell(r,new Date(u.createdAt).toLocaleString('tr-TR'));const a=cell(r,'');[['edit','Düzenle'],['remove','Sil']].forEach(([x,l])=>{const b=document.createElement('button');b.type='button';b.className=x==='remove'?'danger-button compact':'secondary-button';b.dataset.action=x;b.dataset.id=u.id;b.textContent=l;a.append(b)});$('list').append(r)})}
function connect(){socket=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);socket.onopen=()=>{$('socket-status').textContent='Canlı';$('socket-status').className='status online'};socket.onmessage=e=>{const s=JSON.parse(e.data);if(s.type==='state')render(s);if(s.type==='mqttUserSuccess'||s.type==='mqttUserError'){$('result').textContent=s.message;$('result').className=s.type.endsWith('Success')?'result-success':'result-error';if(s.type.endsWith('Success'))resetForm()}};socket.onclose=()=>{$('socket-status').textContent='Bağlantı kesildi';$('socket-status').className='status offline';setTimeout(connect,2000)}}resetForm();connect();
</script></body></html>
