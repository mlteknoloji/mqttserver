<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Log Rotasyonu · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/style.css"></head><body><%- include('partials/standalone-sidebar',{activePage:'log-rotation'}) %><main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY SİSTEM</p><h1>Log Rotasyonu</h1></div><div class="standalone-nav"><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>Otomatik arşivleme ve silme</h2><span>logs/device-status-*.log</span></div><form id="settings" class="email-settings-form"><label>Kaç gün sonra arşivlensin?<input id="archive-days" type="number" min="1" max="3650" required></label><label>Kaç gün sonra silinsin?<input id="delete-days" type="number" min="1" max="3650" required></label><label class="toggle-label"><span>Otomatik rotasyon etkin</span><span class="toggle-switch"><input id="enabled" type="checkbox"><span class="toggle-slider"></span></span></label><div class="send-row"><button class="send-button">Ayarları Kaydet</button><button id="run" class="secondary-button" type="button">Şimdi Çalıştır</button><span id="result"></span></div></form><div class="empty">Eski günlükler <code>.log.gz</code> olarak sıkıştırılır. Silme süresi dolan hem düz hem sıkıştırılmış günlükler kalıcı olarak kaldırılır. İşlem sunucu açılışında ve altı saatte bir çalışır.</div></section></main>
<script>const $=id=>document.getElementById(id),result=$('result');async function load(){const r=await fetch('/api/log-rotation'),x=await r.json();$('enabled').checked=x.enabled;$('archive-days').value=x.archiveAfterDays;$('delete-days').value=x.deleteAfterDays}function show(message,error=false){result.textContent=message;result.className=error?'result-error':'result-success'}$('settings').onsubmit=async e=>{e.preventDefault();try{const r=await fetch('/api/log-rotation',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:$('enabled').checked,archiveAfterDays:+$('archive-days').value,deleteAfterDays:+$('delete-days').value})}),x=await r.json();if(!r.ok)throw new Error(x.error);show(x.message)}catch(error){show(error.message,true)}};$('run').onclick=async()=>{try{const r=await fetch('/api/log-rotation/run',{method:'POST'}),x=await r.json();if(!r.ok)throw new Error(x.error);show(x.message)}catch(error){show(error.message,true)}};load().catch(error=>show(error.message,true));</script></body></html>
