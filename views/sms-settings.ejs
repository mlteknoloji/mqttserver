<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Netgsm SMS · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/style.css"></head><body><%- include('partials/standalone-sidebar',{activePage:'sms-settings'}) %><main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY BİLDİRİM</p><h1>Netgsm SMS Ayarları</h1></div><div class="standalone-nav"><span id="socket-status" class="status offline">Bağlanıyor...</span><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>REST v2 API</h2><span>HTTP Basic Auth / JSON POST</span></div><form id="settings" class="email-settings-form"><label>API alt kullanıcı adı<input id="username" required placeholder="850XXXXXXX"></label><label>API alt kullanıcı şifresi<input id="password" type="password" placeholder="Değiştirmemek için boş bırakın"></label><label>Gönderici başlığı<input id="msgheader" required minlength="3" maxlength="11"></label><label>Kodlama<select id="encoding"><option>TR</option><option>UTF-8</option><option>UNICODE</option></select></label><label>İYS filtresi<select id="iysfilter"><option value="0">0 — Bilgilendirme</option><option value="11">11 — Bireysel ticari</option><option value="12">12 — Tacir ticari</option></select></label><label>Uygulama adı<input id="appname" value="NetRelay" maxlength="50"></label><label class="toggle-label"><span>SMS gönderimi etkin</span><span class="toggle-switch"><input id="enabled" type="checkbox"><span class="toggle-slider"></span></span></label><div class="send-row"><button class="send-button">Kaydet</button><span id="result"></span></div></form><form id="test-form" class="blacklist-form"><label>Test telefon numarası<input id="test-number" required placeholder="5XXXXXXXXX"></label><button class="secondary-button">Test SMS gönder</button></form><div class="empty">Netgsm hesabında API alt kullanıcısı ve onaylı gönderici başlığı tanımlanmış olmalıdır.</div></section></main>
<script>let socket;const $=id=>document.getElementById(id);$('settings').onsubmit=e=>{e.preventDefault();socket.send(JSON.stringify({type:'netgsmSettingsSave',settings:{username:$('username').value,password:$('password').value,msgheader:$('msgheader').value,encoding:$('encoding').value,iysfilter:$('iysfilter').value,appname:$('appname').value,enabled:$('enabled').checked}}));$('result').textContent='Kaydediliyor...'};$('test-form').onsubmit=e=>{e.preventDefault();socket.send(JSON.stringify({type:'netgsmSendTest',number:$('test-number').value}));$('result').textContent='Test SMS gönderiliyor...'};function render(s){const x=s.netgsmSettings||{};$('username').value=x.username||'';$('password').value='';$('password').placeholder=x.hasPassword?'Şifre kayıtlı; değiştirmek için yazın':'API alt kullanıcı şifresi';$('msgheader').value=x.msgheader||'';$('encoding').value=x.encoding||'TR';$('iysfilter').value=x.iysfilter||'0';$('appname').value=x.appname||'NetRelay';$('enabled').checked=x.enabled===true}function connect(){socket=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);socket.onopen=()=>{$('socket-status').textContent='Canlı';$('socket-status').className='status online'};socket.onmessage=e=>{const s=JSON.parse(e.data);if(s.type==='state')render(s);if(s.type==='netgsmSuccess'||s.type==='netgsmError'){$('result').textContent=s.message;$('result').className=s.type.endsWith('Success')?'result-success':'result-error'}};socket.onclose=()=>setTimeout(connect,2000)}connect();</script></body></html>
