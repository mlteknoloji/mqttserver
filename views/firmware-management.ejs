<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Firmware Güncelleme · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="stylesheet" href="/style.css"></head><body>
<main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY MQTT OTA</p><h1>Firmware Güncelleme</h1></div><div class="standalone-nav"><span id="socket-status" class="status offline">Bağlanıyor...</span><a class="secondary-button" href="/">Ana panel</a><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>Firmware dosyaları</h2><span>ESP32 OTA / SHA-256</span></div><form id="upload" class="firmware-upload-form" enctype="multipart/form-data"><label>Firmware .bin<input name="firmware" type="file" accept=".bin,application/octet-stream" required></label><label>Sürüm<input name="version" required placeholder="S-3.3.6"></label><label>Donanım modeli<input name="hardware" required value="ESP32-S3/W5500/8MB"></label><label>Not<input name="notes" maxlength="300"></label><div class="send-row"><button class="send-button">Firmware yükle</button><span id="upload-result"></span></div></form>
<div class="firmware-start firmware-multi-start"><label>Firmware<select id="firmware"><option value="">Firmware seçin</option></select></label><label>Hedef cihazlar <small>Birden fazla cihaz seçmek için Ctrl/⌘ tuşunu kullanın.</small><select id="devices" multiple size="7"></select></label><button id="start" class="danger-button" type="button">Seçili cihazları güncelle</button><span id="result"></span></div>
<div class="table-wrap"><table><thead><tr><th>Sürüm</th><th>Donanım</th><th>Dosya</th><th>SHA-256</th><th>İşlem</th></tr></thead><tbody id="list"></tbody></table><p id="empty" class="empty">Yüklü firmware yok.</p></div><div class="panel-title"><h2>Güncelleme geçmişi</h2><span>Son 100 işlem</span></div><div class="table-wrap"><table><thead><tr><th>Cihaz</th><th>Firmware</th><th>Durum</th><th>İlerleme</th><th>Mesaj</th></tr></thead><tbody id="jobs"></tbody></table><p id="empty-jobs" class="empty">Henüz işlem yok.</p></div></section></main>
<script>
let socket,firmwares=[];const $=id=>document.getElementById(id),cell=(r,v)=>{const c=document.createElement('td');c.textContent=v;r.append(c);return c};
$('upload').onsubmit=async e=>{e.preventDefault();$('upload-result').textContent='Yükleniyor...';try{const r=await fetch('/api/firmwares',{method:'POST',body:new FormData(e.target)}),d=await r.json();if(!r.ok)throw Error(d.error||'Yükleme başarısız');$('upload-result').textContent=d.message;$('upload-result').className='result-success';e.target.reset()}catch(x){$('upload-result').textContent=x.message;$('upload-result').className='result-error'}};
$('start').onclick=()=>{const firmwareId=+$('firmware').value,targetClientIds=[...$('devices').selectedOptions].map(x=>x.value),f=firmwares.find(x=>x.id===firmwareId);if(!f||!targetClientIds.length){$('result').textContent='Firmware ve en az bir cihaz seçin.';$('result').className='result-error';return}if(confirm(`${f.version}, seçilen ${targetClientIds.length} cihaza gönderilsin mi?`)){socket.send(JSON.stringify({type:'firmwareUpdateStart',firmwareId,targetClientIds}));$('result').textContent='OTA işlemleri başlatılıyor...'}};
$('list').onclick=e=>{const b=e.target.closest('[data-remove]');if(b&&confirm('Firmware silinsin mi?'))socket.send(JSON.stringify({type:'firmwareRemove',id:+b.dataset.remove}))};
function render(s){const state=s.firmwareManagement||{firmwares:[],jobs:[]};firmwares=state.firmwares||[];const sf=$('firmware').value,sd=[...$('devices').selectedOptions].map(x=>x.value);$('firmware').replaceChildren(new Option('Firmware seçin',''));firmwares.forEach(x=>$('firmware').append(new Option(`${x.version} — ${x.hardware}`,x.id)));if([...$('firmware').options].some(x=>x.value===sf))$('firmware').value=sf;$('devices').replaceChildren();const usernames=new Set();(s.onlineClients||[]).forEach(x=>{if(usernames.has(x.username))return;usernames.add(x.username);const o=new Option(`${x.username} — ${x.hostname||x.clientId}`,x.clientId);o.selected=sd.includes(x.clientId);$('devices').append(o)});$('list').replaceChildren();$('empty').classList.toggle('hidden',firmwares.length>0);firmwares.forEach(x=>{const r=document.createElement('tr');cell(r,x.version);cell(r,x.hardware);cell(r,`${x.originalName} (${(x.size/1024/1024).toFixed(2)} MB)`);const sha=cell(r,x.sha256);sha.className='sha-cell';const a=cell(r,'');const b=document.createElement('button');b.className='danger-button compact';b.dataset.remove=x.id;b.textContent='Sil';a.append(b);$('list').append(r)});const jobs=state.jobs||[];$('jobs').replaceChildren();$('empty-jobs').classList.toggle('hidden',jobs.length>0);jobs.forEach(j=>{const r=document.createElement('tr');cell(r,j.targetUsername);cell(r,firmwares.find(x=>x.id===j.firmwareId)?.version||`#${j.firmwareId}`);cell(r,j.status);const p=cell(r,`${j.progress}%`),bar=document.createElement('div');bar.className='firmware-progress';bar.innerHTML=`<span style="width:${j.progress}%"></span>`;p.append(bar);const m=cell(r,j.message||'—');m.append(Object.assign(document.createElement('small'),{textContent:new Date(j.updatedAt).toLocaleString('tr-TR')}));$('jobs').append(r)})}
function connect(){socket=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);socket.onopen=()=>{$('socket-status').textContent='Canlı';$('socket-status').className='status online'};socket.onmessage=e=>{const s=JSON.parse(e.data);if(s.type==='state')render(s);if(s.type==='firmwareSuccess'||s.type==='firmwareError'){$('result').textContent=s.message;$('result').className=s.type==='firmwareSuccess'?'result-success':'result-error'}};socket.onclose=()=>{$('socket-status').textContent='Bağlantı kesildi';$('socket-status').className='status offline';setTimeout(connect,2000)}}connect();
</script></body></html>
