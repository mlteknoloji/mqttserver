<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Zamanlanmış Görevler · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="stylesheet" href="/style.css"></head><body>
<main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY MQTT</p><h1>Zamanlanmış Görevler</h1></div><div class="standalone-nav"><span id="socket-status" class="status offline">Bağlanıyor...</span><a class="secondary-button" href="/">Ana panel</a><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>Görev tanımı</h2><span>Cron / gün doğumu / gün batımı</span></div>
<form id="schedule-form" class="schedule-form"><input id="schedule-id" type="hidden"><label>Görev adı<input id="schedule-name" required maxlength="100"></label><label>Hedef MQTT kullanıcısı<input id="schedule-target" required list="schedule-users"></label><datalist id="schedule-users"></datalist>
<fieldset><legend>Röleler</legend><div class="relay-options"><% [1,2,3,4].forEach(r=>{ %><label class="relay-option"><input class="schedule-relay" type="checkbox" value="<%= r %>"> Röle <%= r %></label><% }) %></div></fieldset>
<fieldset><legend>Yeni konum</legend><div class="relay-options"><label class="relay-option"><input type="radio" name="schedule-position" value="1" checked> Açık</label><label class="relay-option"><input type="radio" name="schedule-position" value="0"> Kapalı</label></div></fieldset>
<label>Çalışma biçimi<select id="schedule-mode"><option value="cron">Cron</option><option value="sunrise">Gün doğumu</option><option value="sunset">Gün batımı</option></select></label><label>Eski konuma dön (saniye)<input id="schedule-restore" type="number" min="0" max="4294967" value="0"></label>
<div id="cron-builder" class="cron-builder"><label>Dakika<select id="cron-minute"><option value="*">Her dakika</option><option value="*/5">5 dakikada bir</option><option value="*/10">10 dakikada bir</option><option value="*/15">15 dakikada bir</option><option value="*/30">30 dakikada bir</option></select></label><label>Saat<select id="cron-hour"><option value="*">Her saat</option></select></label><label>Ayın günü<select id="cron-day"><option value="*">Her gün</option></select></label><label>Ay<select id="cron-month"><option value="*">Her ay</option></select></label><label>Haftanın günü<select id="cron-weekday"><option value="*">Her gün</option><option value="1-5">Hafta içi</option><option value="0,6">Hafta sonu</option><option value="1">Pazartesi</option><option value="2">Salı</option><option value="3">Çarşamba</option><option value="4">Perşembe</option><option value="5">Cuma</option><option value="6">Cumartesi</option><option value="0">Pazar</option></select></label></div>
<label class="cron-value">Cron değeri<input id="schedule-cron" required value="* * * * *"></label><div id="solar-fields" class="solar-fields hidden"><label>Enlem<input id="schedule-latitude" type="number" min="-90" max="90" step="any"></label><label>Boylam<input id="schedule-longitude" type="number" min="-180" max="180" step="any"></label><label>Dakika ekle/çıkar<input id="schedule-solar-offset" type="number" min="-1440" max="1440" value="0"></label></div>
<label class="toggle-label schedule-enabled"><span>Görev etkin</span><span class="toggle-switch"><input id="schedule-enabled" type="checkbox" checked><span class="toggle-slider"></span></span></label><div class="send-row"><button class="send-button">Kaydet</button><button id="schedule-reset" class="secondary-button" type="button">Yeni görev</button><span id="schedule-result"></span></div></form>
<div class="table-wrap"><table><thead><tr><th>Görev</th><th>Hedef / Röle</th><th>Zaman</th><th>Geri al</th><th>Sonuç</th><th>İşlem</th></tr></thead><tbody id="schedule-list"></tbody></table><p id="empty-schedules" class="empty">Henüz görev yok.</p></div></section></main>
<script>
let socket,tasks=[];const $=id=>document.getElementById(id), form=$('schedule-form');for(let i=0;i<24;i++)$('cron-hour').add(new Option(String(i).padStart(2,'0'),i));for(let i=1;i<=31;i++)$('cron-day').add(new Option(i,i));for(let i=1;i<=12;i++)$('cron-month').add(new Option(i,i));
function cron(){ $('schedule-cron').value=['minute','hour','day','month','weekday'].map(x=>$(`cron-${x}`).value).join(' ') }document.querySelectorAll('#cron-builder select').forEach(x=>x.onchange=cron);
function mode(){const solar=$('schedule-mode').value!=='cron';$('solar-fields').classList.toggle('hidden',!solar);$('cron-builder').classList.toggle('hidden',solar)}$('schedule-mode').onchange=mode;
function reset(){form.reset();$('schedule-id').value='';$('schedule-enabled').checked=true;cron();mode()}$('schedule-reset').onclick=reset;
form.onsubmit=e=>{e.preventDefault();socket.send(JSON.stringify({type:'scheduledTaskSave',task:{id:$('schedule-id').value||undefined,name:$('schedule-name').value,targetUsername:$('schedule-target').value,relays:[...document.querySelectorAll('.schedule-relay:checked')].map(x=>+x.value),position:+document.querySelector('[name="schedule-position"]:checked').value,cron:$('schedule-cron').value,mode:$('schedule-mode').value,latitude:$('schedule-latitude').value,longitude:$('schedule-longitude').value,solarOffsetMinutes:+$('schedule-solar-offset').value,restoreSeconds:+$('schedule-restore').value,enabled:$('schedule-enabled').checked}}));$('schedule-result').textContent='Kaydediliyor...'};
$('schedule-list').onclick=e=>{const b=e.target.closest('[data-action]');if(!b)return;const t=tasks.find(x=>x.id===+b.dataset.id);if(b.dataset.action==='toggle')socket.send(JSON.stringify({type:'scheduledTaskEnabled',id:t.id,enabled:!t.enabled}));if(b.dataset.action==='remove'&&confirm('Görev silinsin mi?'))socket.send(JSON.stringify({type:'scheduledTaskRemove',id:t.id}));if(b.dataset.action==='edit'){ $('schedule-id').value=t.id;$('schedule-name').value=t.name;$('schedule-target').value=t.targetUsername;$('schedule-mode').value=t.mode;$('schedule-cron').value=t.cron;$('schedule-restore').value=t.restoreSeconds;$('schedule-latitude').value=t.latitude??'';$('schedule-longitude').value=t.longitude??'';$('schedule-solar-offset').value=t.solarOffsetMinutes;$('schedule-enabled').checked=t.enabled;document.querySelectorAll('.schedule-relay').forEach(x=>x.checked=t.relays.includes(+x.value));document.querySelector(`[name="schedule-position"][value="${t.position}"]`).checked=true;mode();scrollTo({top:0,behavior:'smooth'})}};
function cell(r,v){const c=document.createElement('td');c.textContent=v;r.append(c);return c}function render(s){tasks=s.scheduledTasks||[];$('schedule-users').replaceChildren(...[...new Set(s.onlineClients.map(x=>x.username))].map(x=>new Option(x)));$('schedule-list').replaceChildren();$('empty-schedules').classList.toggle('hidden',tasks.length>0);tasks.forEach(t=>{const r=document.createElement('tr');cell(r,t.name);cell(r,`${t.targetUsername} / ${t.relays.join(', ')}`);cell(r,t.mode==='cron'?t.cron:`${t.mode==='sunrise'?'Gün doğumu':'Gün batımı'} ${t.solarOffsetMinutes} dk`);cell(r,t.restoreSeconds?`${t.restoreSeconds} sn`:'Kapalı');cell(r,t.lastResult||'Henüz çalışmadı');const a=cell(r,'');[['toggle',t.enabled?'Devre dışı':'Etkinleştir'],['edit','Düzenle'],['remove','Sil']].forEach(([x,l])=>{const b=document.createElement('button');b.type='button';b.className=x==='remove'?'danger-button compact':'secondary-button';b.dataset.action=x;b.dataset.id=t.id;b.textContent=l;a.append(b)});$('schedule-list').append(r)})}
function connect(){socket=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);socket.onopen=()=>{$('socket-status').textContent='Canlı';$('socket-status').className='status online'};socket.onmessage=e=>{const s=JSON.parse(e.data);if(s.type==='state')render(s);if(s.type==='scheduledTaskSuccess'||s.type==='scheduledTaskError'){$('schedule-result').textContent=s.message;$('schedule-result').className=s.type.endsWith('Success')?'result-success':'result-error';if(s.type.endsWith('Success'))reset()}};socket.onclose=()=>{ $('socket-status').textContent='Bağlantı kesildi';$('socket-status').className='status offline';setTimeout(connect,2000)}}reset();connect();
</script></body></html>
