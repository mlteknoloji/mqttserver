<!doctype html>
<html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>REST API · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/style.css"></head>
<body><%- include('partials/standalone-sidebar',{activePage:'api-keys'}) %><main class="standalone-shell api-page">
<header class="standalone-header"><div><p class="eyebrow">NETRELAY ENTEGRASYON</p><h1>REST API ve Home Assistant</h1><p class="page-lead">Mobil uygulamalar ve otomasyon sistemleri için güvenli erişimi yönetin.</p></div><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></header>
<div class="api-settings-grid">
<section class="card panel api-create-card"><div class="panel-title"><div><h2>Yeni API anahtarı <button type="button" class="help-tooltip" aria-label="Token yalnızca oluşturulduğu anda gösterilir." data-tooltip="Token yalnızca oluşturulduğu anda gösterilir.">i</button></h2><span>Güvenli ve grup sınırlı erişim</span></div><span class="api-badge">120 istek/dk</span></div><form id="key-form" class="api-key-form"><label>Anahtar adı<input id="name" required placeholder="Örn. Mobil uygulama" autocomplete="off"></label><label><span class="field-label">Cihaz grupları <button type="button" class="help-tooltip" aria-label="Birden fazla grup seçmek için Ctrl veya Cmd tuşunu basılı tutun." data-tooltip="Birden fazla grup seçmek için Ctrl veya Cmd tuşunu basılı tutun.">i</button></span><select id="allowed-groups" multiple required size="4"></select></label><fieldset class="api-permissions"><legend>Yetkiler</legend><label class="ios-setting"><span><strong>Durum okuma <button type="button" class="help-tooltip" aria-label="Bu anahtar cihazları, bağlantı durumlarını ve olay geçmişini görüntüleyebilir." data-tooltip="Cihazları, bağlantı durumlarını ve olay geçmişini görüntüleyebilir.">i</button></strong></span><span class="toggle-switch"><input class="scope" type="checkbox" value="read" checked><span class="toggle-slider"></span></span></label><label class="ios-setting"><span><strong>Röle kontrolü <button type="button" class="help-tooltip" aria-label="Bu anahtar izin verilen cihazlara röle, yeniden başlatma ve senkronizasyon komutu gönderebilir." data-tooltip="İzin verilen cihazlara röle, yeniden başlatma ve senkronizasyon komutu gönderebilir.">i</button></strong></span><span class="toggle-switch"><input class="scope" type="checkbox" value="control"><span class="toggle-slider"></span></span></label></fieldset><button class="send-button api-primary-action">Anahtar oluştur</button></form><div id="token-result" class="empty api-token-empty">Yeni token burada görüntülenecek. Tokenı not alın; daha sonra tekrar görüntüleyemeyeceksiniz!</div></section>
<section class="card panel api-ha-card"><div class="panel-title"><div><h2>Home Assistant</h2><span>MQTT Discovery · Retain · QoS 1</span></div><span class="api-badge neutral">MQTT</span></div><form id="ha-form" class="api-ha-form"><label><span class="field-label">Discovery prefix <button type="button" class="help-tooltip" aria-label="Home Assistant keşif topic önekidir. Varsayılan homeassistant değeri önerilir." data-tooltip="Home Assistant keşif topic önekidir. Varsayılan ‘homeassistant’ değeri önerilir.">i</button></span><input id="prefix" value="homeassistant" required></label><label><span class="field-label">MQTT kullanıcısı <button type="button" class="help-tooltip" aria-label="Home Assistant bu kullanıcı ve belirlediğiniz parola ile MQTT sunucusuna bağlanır." data-tooltip="Home Assistant bu kullanıcı ve belirlediğiniz parola ile MQTT sunucusuna bağlanır.">i</button></span><input id="ha-username" value="homeassistant" readonly></label><label class="ios-setting prominent"><span><strong>Discovery etkin <button type="button" class="help-tooltip" aria-label="Röleleri switch, inputları binary sensor olarak Home Assistant'a otomatik tanıtır." data-tooltip="Röleleri switch, inputları binary_sensor olarak Home Assistant’a otomatik tanıtır.">i</button></strong></span><span class="toggle-switch"><input id="ha-enabled" type="checkbox"><span class="toggle-slider"></span></span></label><div class="send-row"><button class="send-button">Kaydet ve yayınla</button><span id="ha-result" class="form-feedback"></span></div></form><div class="api-note">Önce <a href="/mqtt-users">MQTT Kullanıcıları</a> ekranında <code>homeassistant</code> kullanıcısını güçlü bir parolayla oluşturun.</div></section>
</div>
<section class="card panel api-list-card"><div class="panel-title"><div><h2>API anahtarları</h2><span>Aktif anahtarlar ve erişebildikleri cihaz grupları</span></div><span id="key-count" class="api-count">0 anahtar</span></div><div class="table-wrap"><table class="api-key-table"><thead><tr><th>Ad</th><th>Token</th><th>Yetkiler</th><th>Cihaz grupları</th><th>Son kullanım</th><th><span class="sr-only">İşlem</span></th></tr></thead><tbody id="keys"></tbody></table></div></section>
<details class="card api-examples"><summary><span><strong>Mobil uygulama örnekleri</strong><small>API v1 isteklerini göster</small></span><span class="details-chevron">⌄</span></summary><div class="raw-json"><pre>GET /api/v1/devices&#10;Authorization: Bearer nr_...&#10;&#10;POST /api/v1/devices/biga_sube/relays&#10;Authorization: Bearer nr_...&#10;Content-Type: application/json&#10;{"relays":[1,2],"position":1,"delay":0}&#10;&#10;POST /api/v1/devices/biga_sube/restart&#10;GET /api/v1/history?username=biga_sube&amp;limit=100</pre></div></details>
</main>
<script>
const $=id=>document.getElementById(id);let groups=[];
document.querySelectorAll('.help-tooltip').forEach(button=>button.addEventListener('click',event=>{event.preventDefault();event.stopPropagation()}));
async function copyToken(token,button,status){try{if(navigator.clipboard&&window.isSecureContext)await navigator.clipboard.writeText(token);else{const area=document.createElement('textarea');area.value=token;area.style.position='fixed';area.style.opacity='0';document.body.append(area);area.select();if(!document.execCommand('copy'))throw new Error('Kopyalama desteklenmiyor.');area.remove()}status.textContent='Kopyalandı';button.classList.add('copied');setTimeout(()=>{status.textContent='Kopyalamak için token üzerine tıklayın';button.classList.remove('copied')},2200)}catch{status.textContent='Kopyalanamadı; tokenı seçip elle kopyalayın.'}}
function scopeLabel(scope){return scope==='read'?'Okuma':scope==='control'?'Kontrol':scope}
async function load(){const r=await fetch('/api/api-keys'),x=await r.json();groups=x.groups||[];$('prefix').value=x.homeAssistant.prefix;$('ha-enabled').checked=x.homeAssistant.enabled;$('allowed-groups').replaceChildren(...groups.map(g=>new Option(`${g.name} · ${g.members.length} cihaz`,g.id)));$('key-count').textContent=`${x.keys.length} anahtar`;$('keys').replaceChildren(...x.keys.map(k=>{const names=(k.allowedGroupIds||[]).map(id=>groups.find(g=>g.id===id)?.name||`#${id}`).join(', ')||'Eski anahtar: tüm gruplar';const tr=document.createElement('tr');const values=[k.name,k.prefix+'…',(k.scopes||[]).map(scopeLabel).join(', '),names,k.lastUsedAt?new Date(k.lastUsedAt).toLocaleString('tr-TR'):'Henüz kullanılmadı'];values.forEach((v,i)=>{const td=document.createElement('td');td.textContent=v;if(i===0)td.className='api-key-name';if(i===1)td.className='api-key-prefix';tr.append(td)});const td=document.createElement('td'),b=document.createElement('button');b.className='danger-button compact';b.textContent='Sil';b.onclick=async()=>{if(await netrelayConfirm('API anahtarı silinsin mi?',{title:'API anahtarını sil',confirmButtonText:'Evet, sil'})){await fetch(`/api/api-keys/${k.id}`,{method:'DELETE'});load()}};td.append(b);tr.append(td);return tr}))}
$('key-form').onsubmit=async e=>{e.preventDefault();const r=await fetch('/api/api-keys',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:$('name').value,scopes:[...document.querySelectorAll('.scope:checked')].map(x=>x.value),allowedGroupIds:[...$('allowed-groups').selectedOptions].map(x=>+x.value)})}),x=await r.json();if(!r.ok){$('token-result').textContent=x.error;return netrelayAlert(x.error,'error')}const result=$('token-result'),button=document.createElement('button'),status=document.createElement('span');result.replaceChildren();result.className='api-token-result';button.type='button';button.className='api-token-copy';button.textContent=x.key.token;button.title='API tokenını panoya kopyala';status.textContent='Kopyalamak için token üzerine tıklayın';button.onclick=()=>copyToken(x.key.token,button,status);result.append('Tokenı şimdi kopyalayın:',button,status);$('key-form').reset();load()};
$('ha-form').onsubmit=async e=>{e.preventDefault();const r=await fetch('/api/home-assistant',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:$('ha-enabled').checked,prefix:$('prefix').value})}),x=await r.json();$('ha-result').textContent=x.message||x.error;if(!r.ok)netrelayAlert(x.error,'error')};load();
</script></body></html>
