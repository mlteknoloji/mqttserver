<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cihaz Grupları · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/style.css"></head><body><%- include('partials/standalone-sidebar',{activePage:'device-groups'}) %><main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY KONTROL</p><h1>Cihaz Grupları</h1></div><div class="standalone-nav"><span id="socket-status" class="status offline">Bağlanıyor...</span><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>Grup tanımı</h2><span>Birden fazla cihaza tek komut</span></div><form id="group-form" class="firmware-start"><input id="group-id" type="hidden"><label>Grup adı<input id="group-name" required maxlength="100"></label><label>Cihazlar<select id="group-members" multiple required></select></label><div class="send-row"><button class="send-button">Kaydet</button><button id="group-new" class="secondary-button" type="button">Yeni grup</button><span id="result"></span></div></form><div class="table-wrap"><table><thead><tr><th>Grup</th><th>Üyeler</th><th>İşlem</th></tr></thead><tbody id="groups"></tbody></table></div></section>
<section class="card panel"><div class="panel-title"><h2>Toplu röle komutu</h2><span>Çevrimdışı cihazlar isteğe bağlı kuyruğa alınır</span></div><form id="command-form" class="schedule-form"><label>Grup<select id="command-group" required></select></label><fieldset><legend>Röleler</legend><div class="relay-options"><% [1,2,3,4].forEach(x=>{ %><label class="relay-option"><input class="group-relay" type="checkbox" value="<%=x%>"> Röle <%=x%></label><% }) %></div></fieldset><label>Konum<select id="position"><option value="1">Aç / 1</option><option value="0">Kapat / 0</option></select></label><label>Eski konuma dön (sn)<input id="delay" type="number" min="0" value="0"></label><label class="toggle-label"><span>Çevrimdışı cihazları kuyruğa al</span><span class="toggle-switch"><input id="queue-offline" type="checkbox" checked><span class="toggle-slider"></span></span></label><div class="send-row"><button class="danger-button">Gruba gönder</button></div></form></section>
<section class="card panel"><div class="panel-title"><h2>Komut kuyruğu</h2><span>Son 200 kayıt</span></div><div class="table-wrap"><table><thead><tr><th>Zaman</th><th>Cihaz</th><th>Kaynak</th><th>Durum</th><th>İşlem</th></tr></thead><tbody id="queue"></tbody></table></div></section></main>
<script>let socket,groups=[],queue=[];const $=id=>document.getElementById(id),cell=(r,v)=>{const c=document.createElement('td');c.textContent=v;r.append(c);return c};function resetGroup(){$('group-form').reset();$('group-id').value=''}$('group-new').onclick=resetGroup;$('group-form').onsubmit=e=>{e.preventDefault();socket.send(JSON.stringify({type:'deviceGroupSave',group:{id:$('group-id').value||undefined,name:$('group-name').value,members:[...$('group-members').selectedOptions].map(x=>x.value)}}))};$('groups').onclick=e=>{const b=e.target.closest('[data-action]');if(!b)return;const g=groups.find(x=>x.id===+b.dataset.id);if(b.dataset.action==='remove'&&confirm('Grup silinsin mi?'))socket.send(JSON.stringify({type:'deviceGroupRemove',id:g.id}));if(b.dataset.action==='edit'){$('group-id').value=g.id;$('group-name').value=g.name;[...$('group-members').options].forEach(x=>x.selected=g.members.includes(x.value));scrollTo({top:0,behavior:'smooth'})}};$('command-form').onsubmit=e=>{e.preventDefault();if(!confirm('Komut seçilen gruptaki cihazlara gönderilsin mi?'))return;socket.send(JSON.stringify({type:'deviceGroupCommand',groupId:+$('command-group').value,relays:[...document.querySelectorAll('.group-relay:checked')].map(x=>+x.value),position:+$('position').value,delay:+$('delay').value,queueOffline:$('queue-offline').checked}))};$('queue').onclick=e=>{const b=e.target.closest('[data-remove]');if(b&&confirm('Kuyruk kaydı silinsin mi?'))socket.send(JSON.stringify({type:'queuedCommandRemove',id:+b.dataset.remove}))};function render(s){groups=s.deviceGroups||[];queue=s.commandQueue||[];const selected=[...$('group-members').selectedOptions].map(x=>x.value);$('group-members').replaceChildren(...(s.knownMqttUsernames||[]).map(x=>new Option(`${x}${s.onlineClients.some(c=>c.username===x)?' (çevrimiçi)':''}`,x)));[...$('group-members').options].forEach(x=>x.selected=selected.includes(x.value));$('command-group').replaceChildren(...groups.map(x=>new Option(x.name,x.id)));$('groups').replaceChildren();groups.forEach(g=>{const r=document.createElement('tr');cell(r,g.name);cell(r,g.members.join(', '));const a=cell(r,'');[['edit','Düzenle'],['remove','Sil']].forEach(([x,l])=>{const b=document.createElement('button');b.type='button';b.className=x==='remove'?'danger-button compact':'secondary-button';b.dataset.action=x;b.dataset.id=g.id;b.textContent=l;a.append(b)});$('groups').append(r)});$('queue').replaceChildren();queue.forEach(q=>{const r=document.createElement('tr');cell(r,new Date(q.queuedAt).toLocaleString('tr-TR'));cell(r,q.targetUsername);cell(r,q.source);cell(r,q.status+(q.lastError?` / ${q.lastError}`:''));const a=cell(r,'');if(q.status==='queued'){const b=document.createElement('button');b.className='danger-button compact';b.dataset.remove=q.id;b.textContent='Sil';a.append(b)}$('queue').append(r)})}function connect(){socket=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);socket.onopen=()=>{$('socket-status').textContent='Canlı';$('socket-status').className='status online'};socket.onmessage=e=>{const s=JSON.parse(e.data);if(s.type==='state')render(s);if(s.type==='deviceGroupSuccess'||s.type==='deviceGroupError'){$('result').textContent=s.message;$('result').className=s.type.endsWith('Success')?'result-success':'result-error'}};socket.onclose=()=>setTimeout(connect,2000)}connect();</script></body></html>
