<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MQTT Blacklist · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="stylesheet" href="/style.css"></head><body>
<main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY GÜVENLİK</p><h1>MQTT Blacklist</h1></div><div class="standalone-nav"><span id="socket-status" class="status offline">Bağlanıyor...</span><a class="secondary-button" href="/">Ana panel</a><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section class="card panel"><div class="panel-title"><h2>Engellenen IP adresleri</h2><span>SQLite üzerinde kalıcı</span></div><form id="form" class="blacklist-form"><label>IP adresi<input id="ip" required placeholder="192.168.1.25"></label><label>Açıklama<input id="reason" maxlength="200" placeholder="Manuel engelleme nedeni"></label><button class="danger-button">Blacklist'e ekle</button><span id="result"></span></form><div class="table-wrap"><table><thead><tr><th>IP adresi</th><th>Neden</th><th>Hatalı giriş</th><th>Engellenme</th><th>Bitiş</th><th>İşlem</th></tr></thead><tbody id="list"></tbody></table><p id="empty" class="empty">Blacklist boş.</p></div></section></main>
<script>
let socket;const $=id=>document.getElementById(id),cell=(r,v)=>{const c=document.createElement('td');c.textContent=v;r.append(c);return c};$('form').onsubmit=e=>{e.preventDefault();socket.send(JSON.stringify({type:'blacklistAdd',ip:$('ip').value,reason:$('reason').value}));$('result').textContent='İşlem yapılıyor...';e.target.reset()};$('list').onclick=e=>{const b=e.target.closest('[data-ip]');if(b&&confirm(`${b.dataset.ip} blacklist listesinden kaldırılsın mı?`)){socket.send(JSON.stringify({type:'blacklistRemove',ip:b.dataset.ip}));$('result').textContent='İşlem yapılıyor...'}};
function render(s){const entries=s.blacklist||[];$('list').replaceChildren();$('empty').classList.toggle('hidden',entries.length>0);entries.forEach(x=>{const r=document.createElement('tr');cell(r,x.ip);cell(r,x.reason);cell(r,x.failedAttempts);cell(r,new Date(x.bannedAt).toLocaleString('tr-TR'));cell(r,x.expiresAt?new Date(x.expiresAt).toLocaleString('tr-TR'):'Süresiz');const a=cell(r,'');const b=document.createElement('button');b.className='danger-button compact';b.dataset.ip=x.ip;b.textContent='Kaldır';a.append(b);$('list').append(r)})}
function connect(){socket=new WebSocket(`${location.protocol==='https:'?'wss:':'ws:'}//${location.host}`);socket.onopen=()=>{$('socket-status').textContent='Canlı';$('socket-status').className='status online'};socket.onmessage=e=>{const s=JSON.parse(e.data);if(s.type==='state')render(s);if(s.type==='blacklistSuccess'||s.type==='blacklistError'){$('result').textContent=s.message;$('result').className=s.type==='blacklistSuccess'?'result-success':'result-error'}};socket.onclose=()=>{$('socket-status').textContent='Bağlantı kesildi';$('socket-status').className='status offline';setTimeout(connect,2000)}}connect();
</script></body></html>
