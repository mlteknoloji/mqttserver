<% const allowed = (permission) => currentUser.role === 'admin' || currentUser.permissions.includes(permission); %>
<button id="menu-toggle" class="menu-toggle" type="button" aria-label="Menüyü aç" aria-controls="sidebar" aria-expanded="false">☰</button><div id="sidebar-overlay" class="sidebar-overlay"></div>
<aside id="sidebar" class="sidebar"><a class="sidebar-brand" href="/" aria-label="MQTT Sunucu Paneli ana sayfa"><span>NETRELAY</span><strong>MQTT Server</strong></a><nav class="sidebar-nav" aria-label="Ana menü">
<% if (allowed('dashboard')) { %><div class="nav-group <%= ['dashboard','device-io'].includes(activePage) ? '' : 'collapsed' %>" data-nav-group="monitoring"><button class="nav-group-title" type="button">İZLEME <span>⌄</span></button><div class="nav-group-items"><a href="/#dashboard"><span>⌂</span> Genel Bakış</a><a href="/#online-clients"><span>●</span> Çevrimiçi Cihazlar</a><a class="<%= activePage==='device-io'?'active':'' %>" href="/device-io"><span>⌁</span> Cihaz I/O İzleme</a></div></div><% } %>
<div class="nav-group <%= ['scheduled-tasks','firmware-management'].includes(activePage) ? '' : 'collapsed' %>" data-nav-group="automation"><button class="nav-group-title" type="button">KONTROL VE OTOMASYON <span>⌄</span></button><div class="nav-group-items"><% if(allowed('relay')) { %><a href="/#relay-command"><span>⇄</span> Röle Komutu</a><% } %><% if(allowed('schedules')) { %><a class="<%= activePage==='scheduled-tasks'?'active':'' %>" href="/scheduled-tasks"><span>◷</span> Zamanlanmış Görevler</a><% } %><% if(allowed('firmware')) { %><a class="<%= activePage==='firmware-management'?'active':'' %>" href="/firmware-management"><span>⇧</span> Firmware Güncelleme</a><% } %></div></div>
<div class="nav-group <%= ['mqtt-blacklist','email-notifications'].includes(activePage) ? '' : 'collapsed' %>" data-nav-group="security"><button class="nav-group-title" type="button">BİLDİRİM VE GÜVENLİK <span>⌄</span></button><div class="nav-group-items"><% if(allowed('email')) { %><a class="<%= activePage==='email-notifications'?'active':'' %>" href="/email-notifications"><span>✉</span> E-posta Bildirimleri</a><% } %><% if(allowed('blacklist')) { %><a class="<%= activePage==='mqtt-blacklist'?'active':'' %>" href="/mqtt-blacklist"><span>⊘</span> MQTT Blacklist</a><% } %></div></div>
<div class="nav-group <%= activePage==='web-users' ? '' : 'collapsed' %>" data-nav-group="system"><button class="nav-group-title" type="button">SİSTEM <span>⌄</span></button><div class="nav-group-items"><% if(allowed('logs')) { %><a href="/#server-logs"><span>≡</span> Sunucu Logları</a><% } %><% if(currentUser.role==='admin') { %><a class="<%= activePage==='web-users'?'active':'' %>" href="/web-users"><span>♙</span> Kullanıcı Yönetimi</a><% } %></div></div>
</nav><div class="sidebar-footer"><label class="theme-control" for="theme-toggle"><span id="theme-icon">☾</span><span id="theme-label">Karanlık tema</span><span class="toggle-switch"><input id="theme-toggle" type="checkbox"><span class="toggle-slider"></span></span></label><small><%= currentUser.username %></small></div></aside><script src="/standalone-nav.js" defer></script>
