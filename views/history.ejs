<!doctype html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Olay Geçmişi · NetRelay</title><script>document.documentElement.dataset.theme=localStorage.getItem('netrelay-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/standalone-sidebar',{activePage:'history'}) %><main class="standalone-shell"><header class="standalone-header"><div><p class="eyebrow">NETRELAY İZLEME</p><h1>Olay ve Denetim Geçmişi</h1></div><div class="standalone-nav"><form method="post" action="/logout"><button class="secondary-button">Çıkış</button></form></div></header>
<section id="stats" class="summary"></section>
<section class="card panel"><div class="panel-title"><h2>Filtreler</h2><span>En fazla 2.000 kayıt gösterilir</span></div><form id="filters" class="history-filters"><label>MQTT kullanıcıları<select id="username" multiple size="5"><% mqttUsernames.forEach(username=>{ %><option value="<%= username %>"><%= username %></option><% }) %></select><small>Birden fazla cihaz seçebilirsiniz.</small></label><label>Olay türü<select id="type"><option value="">Tümü</option><option value="netrelay_relay_event">Röle</option><option value="netrelay_input_event">Input</option><option value="netrelay_device_status">Cihaz durumu</option><option value="mpower_device_status">mPower durum</option><option value="mpower_outlet_status">mPower outlet</option><option value="mpower_custom">mPower custom</option></select></label><label>Başlangıç<input id="from" type="date"></label><label>Bitiş<input id="to" type="date"></label><div class="send-row"><button class="send-button">Filtrele</button><button id="clear-users" class="secondary-button" type="button">Cihaz Seçimini Temizle</button><button id="csv" class="secondary-button" type="button">CSV indir</button><span id="result"></span></div></form></section>
<section class="card panel"><div class="panel-title"><h2>Cihaz olayları</h2><span id="event-count"></span></div><div class="table-wrap"><table><thead><tr><th>Zaman</th><th>Cihaz</th><th>Tür</th><th>Kanal / Değer</th><th>Uptime</th></tr></thead><tbody id="events"></tbody></table></div></section>
<section class="card panel"><div class="panel-title"><h2>Bağlantı geçmişi</h2></div><div class="table-wrap"><table><thead><tr><th>Zaman</th><th>Cihaz</th><th>Durum</th><th>Client / IP</th></tr></thead><tbody id="connections"></tbody></table></div></section>
<section class="card panel"><div class="panel-title"><h2>Panel denetim kaydı</h2></div><div class="table-wrap"><table><thead><tr><th>Zaman</th><th>Panel kullanıcısı</th><th>İşlem</th><th>Hedef</th></tr></thead><tbody id="audit"></tbody></table></div></section></main>
<script>
const $=id=>document.getElementById(id),cell=(row,value)=>{const item=document.createElement('td');item.textContent=value;row.append(item)};
const duration=ms=>{const minutes=Math.floor((ms||0)/60000),days=Math.floor(minutes/1440),hours=Math.floor(minutes%1440/60);return `${days}g ${hours}sa ${minutes%60}dk`};
function query(){const p=new URLSearchParams({limit:'500'});for(const option of $('username').selectedOptions)p.append('username',option.value);for(const id of ['type','from','to'])if($(id).value)p.set(id,$(id).value);return p}
function rows(target,items,render){$(target).replaceChildren();items.forEach(item=>{const row=document.createElement('tr');render(row,item);$(target).append(row)});if(!items.length){const row=document.createElement('tr'),empty=document.createElement('td');empty.colSpan=5;empty.className='empty';empty.textContent='Kayıt bulunamadı.';row.append(empty);$(target).append(row)}}
async function load(){try{const response=await fetch(`/api/history?${query()}`);if(!response.ok)throw new Error((await response.json()).error||'Geçmiş alınamadı.');const data=await response.json(),s=data.stats,connectionLabels={connected:'Bağlandı',disconnected:'Koptu',stale:'Bayat',recovered:'Düzeldi'};$('stats').innerHTML=`<article class="card"><span>Son 24 saat olay</span><strong>${s.events}</strong></article><article class="card"><span>Bağlantı / kopma</span><strong>${s.connections.connected||0} / ${s.connections.disconnected||0}</strong></article><article class="card"><span>Ortalama cihaz uptime</span><strong>${duration(s.averageUptimeMs)}</strong></article>`;$('event-count').textContent=`${data.events.length} kayıt`;rows('events',data.events,(r,x)=>{cell(r,new Date(x.occurred_at).toLocaleString('tr-TR'));cell(r,x.username);cell(r,x.event_type.replace('netrelay_','').replace('_event',''));cell(r,x.channel==null?'—':`${x.channel} / ${x.value}`);cell(r,duration(x.uptime_ms))});rows('connections',data.connections,(r,x)=>{cell(r,new Date(x.occurred_at).toLocaleString('tr-TR'));cell(r,x.username);cell(r,connectionLabels[x.event_type]||x.event_type);cell(r,`${x.client_id} / ${x.remote_ip}`)});rows('audit',data.audit,(r,x)=>{cell(r,new Date(x.occurred_at).toLocaleString('tr-TR'));cell(r,x.actor);cell(r,x.action);cell(r,x.target||'—')});$('result').textContent=''}catch(error){$('result').textContent=error.message;$('result').className='result-error'}}
$('filters').onsubmit=e=>{e.preventDefault();load()};$('clear-users').onclick=()=>{for(const option of $('username').options)option.selected=false;load()};$('csv').onclick=()=>location.href=`/api/history/events.csv?${query()}`;load();
</script></body></html>
